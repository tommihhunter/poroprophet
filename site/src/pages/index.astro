---
import LiveNow from '../components/LiveNow.astro';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import PickemsPanel from '../components/PickemsPanel.astro';
import TitleRace from '../components/TitleRace.astro';
import { overview, pickems, ratings, series, teamName } from '../lib/data';
import { lockStage, stageLine } from '../lib/nav';
import { pct } from '../lib/format';

const o = overview();
const rt = ratings();
const champ = o.champion ?? '';
const champName = champ ? teamName(champ) : 'UNKNOWN';
const cpRaw = Number(o.champion_p);
const cp = Number.isFinite(cpRaw) ? cpRaw : null;

// "One in every three futures": a simple fraction when champion_p sits close to one, else "About N in 100".
const WORD = ['', 'One', 'Two', 'Three', 'Four', 'Five'];
const NOUN: Record<string, string> = { '1/2': 'a half', '1/3': 'a third', '1/4': 'a quarter', '1/5': 'a fifth', '2/3': 'two thirds', '3/4': 'three quarters' };
const frac = (p: number) => { for (const n of [2, 3, 4, 5]) for (let k = 1; k < n; k++) if (Math.abs(p - k / n) < 0.015) return { k, n }; return null; };
const f = cp == null ? null : frac(cp);
const n100 = cp == null ? 0 : Math.round(cp * 100);
// Tagline: how far the favourite is ahead of the next best team (frozen ratings, same run as the hero number)
const runnerUp = [...rt].filter((r) => r.code !== champ).sort((a, b) => b.p_champion - a.p_champion)[0];
const ratio = cp != null && runnerUp?.p_champion ? cp / runnerUp.p_champion : null;
const ru = runnerUp ? teamName(runnerUp.code) : 'UNKNOWN';
const line1 = ratio == null ? 'Title chance: UNKNOWN.'
  : ratio >= 2.5 ? `${Math.round(ratio)} times as likely as ${ru}, the next best, to lift the cup.`
  : ratio >= 1.95 ? `Twice as likely as ${ru}, the next best, to lift the cup.`
  : ratio >= 1.6 ? `Nearly twice as likely as ${ru}, the next best, to lift the cup.`
  : ratio >= 1.15 ? `Clear of ${ru}, the next best at ${pct(runnerUp.p_champion, 1)}, as the likeliest champion.`
  : `Barely ahead of ${ru} (${pct(runnerUp.p_champion, 1)}) as the likeliest champion.`;
const others = cp == null ? '' : f ? `${WORD[f.n - f.k]} in ${WORD[f.n].toLowerCase()} futures ${f.n - f.k === 1 ? 'crowns' : 'crown'} someone else.` : `About ${100 - n100} in 100 futures crown someone else.`;
const noun = f ? NOUN[`${f.k}/${f.n}`] ?? pct(cp, 1) : pct(cp, 1);
const champRow = rt.find((r) => r.code === champ);
const byElo = [...rt].sort((a, b) => b.elo - a.elo);
const eloRank = byElo.findIndex((r) => r.code === champ) + 1;
const ORD = ['', '', 'second', 'third', 'fourth', 'fifth'];
const lead = champRow?.headline?.split(/\s*[(;,]/)[0]?.trim() || (champRow ? `${champRow.region} seed ${champRow.seed}` : champName);
const best = eloRank === 1 ? 'with the best rating in the field' : eloRank > 1 ? `with the ${ORD[eloRank] ?? `number ${eloRank}`} best rating in the field` : 'rating UNKNOWN';
const closing = cp == null ? '' : `${lead}, ${best}, yet ${noun} is not a certainty. ${others}`;

// Frozen baseline knockouts: KO-F is the likeliest final; the spoiler is the underdog of the series with the highest p_upset.
const ko = series().filter((s) => s.set === 'baseline' && s.phase === 'Knockouts');
const fin = ko.find((s) => s.id === 'KO-F');
const finalPair = fin ? `${teamName(fin.team_a)} v ${teamName(fin.team_b)}` : 'UNKNOWN';
const sp = ko.filter((s) => s.p_upset != null && s.loser).sort((a, b) => (b.p_upset ?? 0) - (a.p_upset ?? 0))[0];
const spoiler = sp ? `${teamName(sp.loser)}, in the ${sp.stage.replace(/\s*\(.*\)/, '').toLowerCase()}` : 'UNKNOWN';
const venue = fin && /\(([^)]+)\)/.exec(fin.time_venue)?.[1];
const finDate = fin && /\d\d\/\d\d\/\d{4}/.exec(fin.time_nz)?.[0];
const finalWhere = venue && finDate ? `${venue}, ${finDate} NZDT` : 'UNKNOWN';

// Callout, short form (README: risk_assumption "in short form"): the region gap in standard errors from
// overview.region_gap_lck_lpl, plus the assumption's closing sentence (what depends on it). Then the detection text
// without the dashboard-tab pointer, US-venue dates in brackets or the internal word "staged".
const sentences = (s: string) => s.split(/(?<=\.)\s+(?=[A-Z])/);
const gap = /([+-]?\d*\.?\d+) logit, sd (\d*\.?\d+)/.exec(o.region_gap_lck_lpl ?? '');
const z = gap ? Math.abs(Number(gap[1]) / Number(gap[2])) : null;
const zText = z == null ? null : z < 1.5 ? 'about one standard error' : `about ${Math.round(z)} standard errors`;
const tail = o.risk_assumption ? sentences(o.risk_assumption).at(-1) : null;
const riskShort = zText ? `The LCK-over-LPL gap is ${zText} from zero.${tail ? ` ${tail}` : ''}` : o.risk_assumption ? sentences(o.risk_assumption)[0] : 'UNKNOWN';
const riskWatch = o.risk_detection
  ? sentences(o.risk_detection).filter((x) => !/\btab\b/i.test(x)).join(' ').replace(/\s*\([^()]*\d\d\/\d\d[^()]*\)/g, '').replace(/\bstaged /g, '')
  : 'UNKNOWN';

// Quick picks from the frozen overview.
const piw = o.playin_winner;
const piwP = rt.find((r) => r.code === piw)?.p_playin;
const sw30 = pickems().filter((p) => p.stage === 'Swiss' && p.slot === '3-0').map((p) => p.pick);
// "Ruler (GEN, ADC)" -> player, team, role
const mvp = /^(.+?)\s*\(([A-Z0-9]+),\s*([A-Za-z]+)\)/.exec(o.finals_mvp ?? '');
const quick: { k: string; teams: string[]; text: string; role?: string }[] = [
  { k: 'Play-In winner', teams: piw ? [piw] : [], text: piw ? `${teamName(piw)}, ${pct(piwP)}` : 'UNKNOWN' },
  { k: 'Swiss 3-0', teams: sw30, text: sw30.length ? sw30.map(teamName).join(' and ') : 'UNKNOWN' },
  { k: 'Finals MVP', teams: mvp ? [mvp[2]] : [], text: mvp ? mvp[1] : (o.finals_mvp ? o.finals_mvp.split(' (')[0] : 'UNKNOWN'), role: mvp?.[3] },
];
const ls = lockStage();
const sealed = (o.baseline_created ?? '').replace(/(\d{2}:\d{2}):\d{2}/, '$1') || 'UNKNOWN';
const foot = `${stageLine()}. Baseline sealed ${sealed}. Data: gol.gg, lolesports.com, official patch notes. Times in NZDT. Exported ${o.exported_nz ?? 'UNKNOWN'}.`;
---
<Base title="Home" active="home" footer={{ left: foot }}>
  <LiveNow />
  <header class="hero">
    <span class="eyebrow">The prophecy for Worlds 2026</span>
    <h1 class="orb">The orb favours {champName}</h1>
    <p class="pro-line">{line1}</p>
  </header>
  <section class="cols home">
    <div class="stack">
      <div class="prophecy">
        <div class="panel pro-stat">
          <span class="disc pro-disc" style="--s:116px">{champ && <Logo code={champ} size={70} alt={champName} />}</span>
          <div class="pro-p">
            <span class="big gold pro-pct">{pct(cp, 1)}</span>
            <span class="muted2">to win Worlds</span>
          </div>
          <dl class="pro-kv">
            <div><dt>Likeliest final</dt><dd>{finalPair}</dd></div>
            <div><dt>Likeliest spoiler</dt><dd>{spoiler}</dd></div>
            <div><dt>Final</dt><dd>{finalWhere}</dd></div>
          </dl>
        </div>
        <p class="pro-phone">Likeliest final: {finalPair}. Likeliest spoiler: {sp ? teamName(sp.loser) : 'UNKNOWN'}.</p>
        {closing && <p class="pro-close">{closing}</p>}
      </div>
      <TitleRace />
    </div>
    <div class="stack side">
      {ls && <PickemsPanel stage={ls} />}
      <div class="callout">
        <span class="eyebrow">Where the orb is clouded</span>
        <p class="risk-short">{riskShort}</p>
        <p class="risk-watch muted2">{riskWatch}</p>
      </div>
      <div class="quick">
        <span class="eyebrow">Quick picks</span>
        <div class="rows">
          {quick.map((q) => <div class="quick-row"><span class="muted2">{q.k}</span><span class="qv">{q.teams.map((c) => <Logo code={c} size={24} />)}<span>{q.text}</span></span></div>)}
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  /* two independent stacks: neither column waits on the other's height */
  .home { align-items: start; }
  .stack { display: flex; flex-direction: column; gap: var(--space-xl); min-width: 0; }
  /* the one display moment: the headline, then the champion % as the single gold number */
  .hero { display: flex; flex-direction: column; gap: var(--space-xs); margin-bottom: calc(-1 * var(--space-sm)); }
  .orb { font-size: var(--fs-hero); line-height: 1; }
  .pro-line { font-size: var(--fs-xl); line-height: 1.35; color: var(--fg2); text-wrap: pretty; }
  .prophecy { display: flex; flex-direction: column; gap: var(--space-md); }
  .pro-stat { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-lg); }
  .pro-p { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .pro-pct { font-size: var(--fs-hero); }
  .pro-p .muted2 { font-size: var(--fs-md); }
  /* key facts under the stat: label left, value right, shared baseline */
  .pro-kv {
    flex: 1 1 100%; margin: 0; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--space-xs) var(--space-lg);
    align-items: baseline; padding-top: var(--space-md); border-top: 1px solid var(--line-strong);
  }
  .pro-kv > div { display: contents; }
  .pro-kv dt { font-size: var(--fs-sm); color: var(--muted); }
  .pro-kv dd { margin: 0; font-size: var(--fs-lg); min-width: 0; }
  .pro-phone { display: none; }
  .pro-close { font-size: var(--fs-lg); line-height: 1.5; color: var(--fg2); max-width: 60ch; text-wrap: pretty; }

  .risk-short { font-size: var(--fs-lg); line-height: 1.45; text-wrap: pretty; }
  .risk-watch { text-wrap: pretty; }
  .quick { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .quick .rows > .quick-row { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-sm); }
  .quick-row > span:last-child { text-align: right; }
  .qv { display: inline-flex; align-items: center; justify-content: flex-end; gap: var(--space-2xs); flex-wrap: wrap; }

  @media (max-width: 640px) {
    /* phone: one column, Pick'Ems first */
    .home { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-lg); }
    .stack { display: contents; }
    .home :global(.pk) { order: -1; }
    .hero { gap: var(--space-2xs); margin-bottom: 0; }
    .prophecy { gap: var(--space-xs); }
    .pro-line, .pro-kv, .pro-close { display: none; }
    .pro-stat { flex-wrap: nowrap; gap: var(--space-sm); }
    .pro-disc { width: 52px; height: 52px; }
    .pro-disc :global(.logo) { width: 44px; height: 44px; }
    .pro-p { gap: var(--space-3xs); }
    .pro-phone { display: block; line-height: 1.5; color: var(--fg2); }
    .risk-short { font-size: var(--fs-md); }
  }
</style>
