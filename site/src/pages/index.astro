---
// Home, in reading order: the Today band (the lead), the prophecy on the live odds with the title race, the model's
// record so far, the next Pick'Ems and the clouded callout, then links on. Plan: docs/superpowers/plans/2026-10-19-home-rework.md (H3).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import PickemsPanel from '../components/PickemsPanel.astro';
import TitleRace from '../components/TitleRace.astro';
import TodayBand from '../components/TodayBand.astro';
import { live, overview, ratings, teamName } from '../lib/data';
import { pickemPoints, resultRows } from '../lib/grading';
import { NAV, lockStage, stageLine } from '../lib/nav';
import { STAGES, knockoutsOutcome, lockPick, view } from '../lib/stage';
import { swissState } from '../lib/swiss';
import { icon } from '../lib/icons';
import { pct } from '../lib/format';
import { url } from '../lib/url';

const o = overview();
const rt = ratings();
// The prophecy reads the live odds (knocked-out teams are absent there), else the frozen baseline.
const lv = live();
const isLive = lv.length > 0;
const odds = (isLive ? lv.map((l) => ({ code: l.team, p: Number(l.p_champion) })) : rt.map((r) => ({ code: r.code, p: Number(r.p_champion) })))
  .filter((r) => Number.isFinite(r.p)).sort((a, b) => b.p - a.p);
const champ = odds[0]?.code ?? '';
const champName = champ ? teamName(champ) : 'UNKNOWN';
const cp = odds[0]?.p ?? null;
const champRow = rt.find((r) => r.code === champ);
const sealDay = /^(\d\d\/\d\d)/.exec(o.baseline_created ?? '')?.[1] ?? 'UNKNOWN';
const sealLine = !isLive ? `Frozen baseline, sealed ${sealDay}` : champRow ? `${pct(champRow.p_champion, 1)} at the seal, ${sealDay}` : '';

// "One in every three futures": a simple fraction when the chance sits close to one, else "About N in 100".
const WORD = ['', 'One', 'Two', 'Three', 'Four', 'Five'];
const NOUN: Record<string, string> = { '1/2': 'a half', '1/3': 'a third', '1/4': 'a quarter', '1/5': 'a fifth', '2/3': 'two thirds', '3/4': 'three quarters' };
const frac = (p: number) => { for (const n of [2, 3, 4, 5]) for (let k = 1; k < n; k++) if (Math.abs(p - k / n) < 0.015) return { k, n }; return null; };
const f = cp == null ? null : frac(cp);
const n100 = cp == null ? 0 : Math.round(cp * 100);
// Tagline: how far the favourite is ahead of the next best team (same odds as the hero number)
const runnerUp = odds[1];
const ratio = cp != null && runnerUp?.p ? cp / runnerUp.p : null;
const ru = runnerUp ? teamName(runnerUp.code) : 'UNKNOWN';
const line1 = ratio == null ? 'Title chance: UNKNOWN.'
  : ratio >= 2.5 ? `${Math.round(ratio)} times as likely as ${ru}, the next best, to lift the cup.`
  : ratio >= 1.95 ? `Twice as likely as ${ru}, the next best, to lift the cup.`
  : ratio >= 1.6 ? `Nearly twice as likely as ${ru}, the next best, to lift the cup.`
  : ratio >= 1.15 ? `Clear of ${ru}, the next best at ${pct(runnerUp.p, 1)}, as the likeliest champion.`
  : `Barely ahead of ${ru} (${pct(runnerUp.p, 1)}) as the likeliest champion.`;
const others = cp == null ? '' : f ? `${WORD[f.n - f.k]} in ${WORD[f.n].toLowerCase()} futures ${f.n - f.k === 1 ? 'crowns' : 'crown'} someone else.` : `About ${100 - n100} in 100 futures crown someone else.`;
const noun = f ? NOUN[`${f.k}/${f.n}`] ?? pct(cp, 1) : pct(cp, 1);
const byElo = [...rt].sort((a, b) => b.elo - a.elo);
const eloRank = byElo.findIndex((r) => r.code === champ) + 1;
const ORD = ['', '', 'second', 'third', 'fourth', 'fifth'];
const lead = champRow?.headline?.split(/\s*[(;,]/)[0]?.trim() || (champRow ? `${champRow.region} seed ${champRow.seed}` : champName);
const best = eloRank === 1 ? 'with the best rating in the field' : eloRank > 1 ? `with the ${ORD[eloRank] ?? `number ${eloRank}`} best rating in the field` : 'rating UNKNOWN';
const closing = cp == null ? '' : `${lead}, ${best}, yet ${noun} is not a certainty. ${others}`;

// After the final the prophecy gives way to the outcome (the stage pages do the same): the champion, the final, the
// sealed baseline's chance for them (the one gold number) and our Pick'Ems champion pick.
const done = knockoutsOutcome();
const lp = lockPick('Knockouts');
const doneSeal = done ? rt.find((r) => r.code === done.winner) : null;
const doneLine = done ? `Beat ${teamName(done.loser)} ${done.score ?? '(score UNKNOWN)'} in the final${done.riot ? ', official stats to follow' : ''}.` : '';
const doneClose = done && lp ? (lp.pick === done.winner ? `Called it: our Pick'Ems champion pick was ${teamName(lp.pick)}, ${pct(lp.p)} at the lock.` : `Our Pick'Ems champion pick was ${teamName(lp.pick)} (${pct(lp.p)} at the lock), wrong.`) : '';

// Likeliest final: KO-F of the latest staged run (the frozen baseline until a run has knockouts), hidden once either
// team is out (absent from the live odds or eliminated in the Swiss): no staged run follows the QFs or SFs.
const out = new Set(swissState().eliminated.map((e) => e.team));
const alive = (c: string) => (!isLive || lv.some((l) => l.team === c)) && !out.has(c);
const fin = view(STAGES[2], 'latest').rows.find((s) => s.id === 'KO-F' && alive(s.team_a) && alive(s.team_b));
const venue = fin && /\(([^)]+)\)/.exec(fin.time_venue)?.[1];
const finDate = fin && /\d\d\/\d\d\/\d{4}/.exec(fin.time_nz)?.[0];
const finalLine = fin ? `Likeliest final ${fin.team_a} v ${fin.team_b}, ${venue && finDate ? `${venue} ${finDate} NZDT` : 'venue and date UNKNOWN'}` : '';

// The model so far: winners called per stage (the latest staged run's pre-start call, lib/grading.ts resultRows, else
// the frozen baseline's; the frozen baseline's own record, which the Scorecard grades, underneath when it differs), then
// Pick'Ems points per stage once any are decided.
const rr = resultRows();
const tally = (hs: (boolean | null | undefined)[]) => { const h = hs.filter((x): x is boolean => x != null); return `${h.filter(Boolean).length} of ${h.length}`; };
const called = [...new Set(rr.map((r) => r.phase))].map((phase) => {
  const mine = rr.filter((r) => r.phase === phase);
  const v = tally(mine.map((r) => r.staged?.hit ?? r.hit)), base = tally(mine.map((r) => r.hit));
  return { k: `${phase} winners called`, v, sub: base !== v && !base.endsWith(' of 0') ? `Frozen baseline ${base}` : '' };
}).filter((x) => !x.v.endsWith(' of 0'));
const points = pickemPoints().filter((p) => p.possible > 0).map((p) => ({
  k: `${p.stage} Pick'Ems points`, v: `${p.earned} of ${p.max ?? 'UNKNOWN'}`, sub: p.max != null && p.possible < p.max ? `${p.possible} decided so far` : '',
}));
const sofar = [...called, ...points];

// Callout, short form (README: risk_assumption "in short form"): the region gap in standard errors from
// overview.region_gap_lck_lpl, plus the assumption's closing sentence (what depends on it). Then the detection text
// without the dashboard-tab pointer, US-venue dates in brackets or the internal word "staged".
const sentences = (s: string) => s.split(/(?<=\.)\s+(?=[A-Z])/);
const gap = /([+-]?\d*\.?\d+) logit, sd (\d*\.?\d+)/.exec(o.region_gap_lck_lpl ?? '');
const z = gap ? Math.abs(Number(gap[1]) / Number(gap[2])) : null;
const zText = z == null ? null : z < 1.5 ? 'about one standard error' : `about ${Math.round(z)} standard errors`;
const tail = o.risk_assumption ? sentences(o.risk_assumption).at(-1) : null;
const riskShort = zText ? `The LCK-over-LPL gap is ${zText} from zero.${tail ? ` ${tail}` : ''}` : o.risk_assumption ? sentences(o.risk_assumption)[0] : 'UNKNOWN';
const riskWatch = o.risk_detection
  ? sentences(o.risk_detection).filter((x) => !/\btab\b/i.test(x)).join(' ').replace(/\s*\([^()]*\d\d\/\d\d[^()]*\)/g, '').replace(/\bstaged /g, '')
  : 'UNKNOWN';

const links = ['playground', 'teams', 'players'].map((id) => NAV.find((n) => n.id === id)!);
const ls = lockStage();
const sealed = (o.baseline_created ?? '').replace(/(\d{2}:\d{2}):\d{2}/, '$1') || 'UNKNOWN';
const foot = `${stageLine()}. Baseline sealed ${sealed}. Data: gol.gg, lolesports.com, official patch notes. Times in NZDT. Exported ${o.exported_nz ?? 'UNKNOWN'}.`;
---
<Base title="Home" active="home" footer={{ left: foot }}>
  <TodayBand />
  <section class="home">
    <div class="stack">
      <header class="hero">
        <span class="eyebrow">{done ? 'Worlds 2026' : 'The prophecy for Worlds 2026'}</span>
        <h1 class="orb">{done ? `${teamName(done.winner)} win Worlds 2026` : `The orb favours ${champName}`}</h1>
        <p class="pro-line">{done ? doneLine : line1}</p>
      </header>
      {done ? (
        <div class="pro-stat">
          <span class="disc pro-disc" style="--s:104px"><Logo code={done.winner} size={64} alt={teamName(done.winner)} /></span>
          <div class="pro-p">
            <span class="big gold pro-pct">{doneSeal ? pct(doneSeal.p_champion, 1) : 'UNKNOWN'}</span>
            <span class="muted2">our title chance for them at the seal, {sealDay}</span>
          </div>
        </div>
      ) : (
        <div class="pro-stat">
          <span class="disc pro-disc" style="--s:104px">{champ && <Logo code={champ} size={64} alt={champName} />}</span>
          <div class="pro-p">
            <span class="big gold pro-pct">{pct(cp, 1)}</span>
            <span class="muted2">to win Worlds{isLive ? ', live' : ''}</span>
            {sealLine && <span class="caption">{sealLine}</span>}
          </div>
        </div>
      )}
      {done ? doneClose && <p class="pro-close">{doneClose}</p> : closing && <p class="pro-close">{closing}</p>}
      {!done && <TitleRace top={8} />}
      {!done && finalLine && <p class="caption">{finalLine}</p>}
    </div>
    <div class="stack side">
      <section class="panel flush msf" aria-label="The model so far">
        <div class="panel-head"><h3>The model so far</h3></div>
        <div class="panel-sec">
          {sofar.length ? (
            <dl class="msf-grid">
              {sofar.map((x) => <div><dt>{x.k}</dt><dd class="big">{x.v}</dd>{x.sub && <dd class="caption">{x.sub}</dd>}</div>)}
            </dl>
          ) : <p class="caption">No series finished yet.</p>}
        </div>
        <a class="link-row" href={url('scorecard/')}>Scorecard<span class="msf-arrow" aria-hidden="true">→</span></a>
      </section>
      {ls && <PickemsPanel stage={ls} />}
      <div class="callout">
        <span class="eyebrow">Where the orb is clouded</span>
        <p class="risk-short">{riskShort}</p>
        <p class="risk-watch muted2">{riskWatch}</p>
      </div>
    </div>
  </section>
  <nav class="go" aria-label="More to explore">
    {links.map((n) => (
      <a class="card go-card" href={url(n.path)}>
        <span class="go-ico" set:html={icon(n.id)} />
        <span class="go-t"><h3>{n.label}</h3><span class="caption">{n.desc}</span></span>
      </a>
    ))}
  </nav>
</Base>
<style>
  /* Today full width above; then two independent stacks, the left (prophecy, title race) wider */
  .home { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-xl) var(--space-2xl); align-items: start; }
  .stack { display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; }
  .side { gap: var(--space-xl); }
  /* the one display moment: the headline, then the favourite's live title % as the single gold number */
  .hero { display: flex; flex-direction: column; gap: var(--space-xs); }
  .orb { font-size: var(--fs-hero); line-height: 1; }
  .pro-line { font-size: var(--fs-xl); line-height: 1.35; color: var(--fg2); text-wrap: pretty; }
  .pro-stat { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-lg); }
  .pro-p { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .pro-pct { margin-bottom: var(--space-3xs); }
  .pro-pct { font-size: var(--fs-hero); }
  .pro-p .muted2 { font-size: var(--fs-md); }
  .pro-close { font-size: var(--fs-lg); line-height: 1.5; color: var(--fg2); max-width: 60ch; text-wrap: pretty; margin-bottom: var(--space-sm); }

  .msf-grid { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-sm) var(--space-md); }
  .msf-grid > div { display: flex; flex-direction: column; gap: var(--space-3xs); min-width: 0; }
  .msf-grid dt { font-size: var(--fs-sm); color: var(--muted); }
  .msf-grid dd { margin: 0; }
  .msf-grid dd.big { font-size: var(--fs-2xl); }
  .msf-arrow { font-size: var(--fs-lg); line-height: 1; }

  .risk-short { font-size: var(--fs-lg); line-height: 1.45; text-wrap: pretty; }
  .risk-watch { text-wrap: pretty; }

  /* links on: icon, title, one line */
  .go { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-sm); }
  .go-card { flex-direction: row; align-items: center; gap: var(--space-sm); padding: var(--space-sm) var(--space-md); }
  .go-ico { display: inline-flex; color: var(--muted2); flex: none; }
  .go-card:hover .go-ico { color: var(--gold); }
  .go-t { display: flex; flex-direction: column; gap: var(--space-3xs); min-width: 0; }
  .go-t h3 { font-size: var(--fs-lg); }

  @media (max-width: 900px) {
    .home { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .home, .side { gap: var(--space-lg); }
    .stack { gap: var(--space-sm); }
    .hero { gap: var(--space-2xs); }
    .pro-line, .pro-close { display: none; }
    .pro-stat { flex-wrap: nowrap; gap: var(--space-sm); }
    .pro-disc { width: 52px; height: 52px; }
    .pro-disc :global(.logo) { width: 44px; height: 44px; }
    .risk-short { font-size: var(--fs-md); }
    .go { grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); }
    .go-card { padding: var(--space-xs) var(--space-sm); }
  }
</style>
