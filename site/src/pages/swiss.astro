---
import LiveNow from '../components/LiveNow.astro';
import Base from '../layouts/Base.astro';
import PickemsPanel from '../components/PickemsPanel.astro';
import RecordTable from '../components/RecordTable.astro';
import SwissBracket from '../components/SwissBracket.astro';
import SwissPools from '../components/SwissPools.astro';
import { overview, series, swiss } from '../lib/data';
import { STAGES, drawPassed, setLabel, swissRecords, view } from '../lib/stage';
import { swissState } from '../lib/swiss';
import { url } from '../lib/url';

const st = STAGES[1];
const v = view(st, 'latest');
const rows = swiss().filter((r) => r.set === v.swissSet);
const staged = v.swissSet !== 'baseline';
const created = (series().find((s) => s.set === v.swissSet)?.created_nz ?? 'UNKNOWN').replace(/(\d\d:\d\d):\d\d/, '$1');
const year = /\d{4}/.exec(st.dates)?.[0];
const from = /^\d\d\/\d\d/.exec(st.dates)?.[0];
const where = st.venue.split(', ').slice(-2).join(', ');
// the draw date is a US date: it counts as done only from the NZ day after it
const { draw, passed: drawn } = drawPassed();
const r1 = swissState().rounds[0].groups[0].matches.length;
const drawLine = staged
  ? `Re-run after the round 1 draw, predicted ${created}.`
  : r1 ? `Round 1 is drawn (${r1} games); the picks below stay preliminary until the re-run.`
  : !draw ? 'These picks are preliminary until the re-run after the round 1 draw.'
  : drawn ? `The round 1 draw was on ${draw} (US time); these picks stay preliminary until the re-run.`
  : `The round 1 draw is on ${draw} (US time), so these picks are preliminary until the re-run.`;
const lede = `${rows.length || 'UNKNOWN'} teams. Rounds 1 and 2 are Bo1, deciders are Bo3. ${drawLine}`;
// before a Swiss run the 16th team is the predicted Play-In winner (model/predict.py), so every row assumes it
const piw = overview().playin_winner;
const caption = `Advance is the chance of reaching 3 wins${staged ? ' given the actual draw' : `, averaged over all legal draws${piw ? ` and assuming ${piw} win the Play-In` : ''}`}.`;
const points = /Swiss [^.]*\./.exec(overview().pickems_points ?? '')?.[0].replace(/^Swiss /, '');
const footLeft = `${staged ? `Staged ${setLabel(v.swissSet)}` : 'Frozen baseline'}, predicted ${created}.${points ? ` Points: ${points}` : ''}`;
---
<Base title="Swiss" active="swiss" description="Swiss stage Pick'Ems and every team's likely record." footer={{ left: footLeft }}>
  <section class="intro sw-intro">
    <span class="eyebrow">Swiss stage, {where}, from {from && year ? `${from}/${year}` : 'UNKNOWN'} NZDT</span>
    <h1>Three wins in, three losses out</h1>
    <p class="lede">{lede}</p>
  </section>
  <LiveNow phase="Swiss" />
  <SwissBracket><p class="caption">What if? <a class="gold" href={url('playground/')}>Play the rest out yourself in the Playground</a>.</p></SwissBracket>
  <PickemsPanel stage="swiss" full />
  <RecordTable rows={rows} records={swissRecords()} caption={caption} />
  <SwissPools />
</Base>
<style>
  /* the h1 needs more than the shared 70ch intro width to stay on one line at desktop widths; the lede keeps its own 60ch */
  .sw-intro { max-width: 1120px; }
</style>
