---
// Knockouts hub, per design/lore/Knockouts.dc.html. Rows: the latest staged set (falls back to the frozen baseline).
import LiveNow from '../components/LiveNow.astro';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { displayName, overview, ratings, results, series } from '../lib/data';
import { pct } from '../lib/format';
import { STAGES, setLabel, startNz, view } from '../lib/stage';
import type { Series } from '../lib/data';

const st = STAGES[2];
const v = view(st, 'latest');
const byId = new Map(v.rows.map((s) => [s.id, s]));
const VENUE: Record<string, string> = { Quarterfinals: 'Quarterfinals, Allen', Semifinals: 'Semifinals, Allen', Final: 'Final, Brooklyn' };
const cols = (st.brackets ?? []).map(([name, ids]) => ({ name, head: VENUE[name] ?? name, items: ids.map((id) => byId.get(id)).filter((s): s is Series => !!s) }));
// column dates from the slots' NZDT starts: "04 to 07/11", "08 and 09/11", "15/11"
const colDays = (items: Series[]) => {
  const d = [...new Set(items.map((s) => startNz(s).slice(0, 5)).filter(Boolean))];
  return !d.length ? '' : d.length === 1 ? d[0] : `${d[0].slice(0, 2)} ${d.length === 2 ? 'and' : 'to'} ${d.at(-1)}`;
};
const all = cols.flatMap((c) => c.items);
const day = (s?: Series) => (s?.time_nz || '').slice(0, 10);
const ord = (d: string) => d.split('/').reverse().join('');
const dates = all.map(day).filter(Boolean).sort((a, b) => ord(a).localeCompare(ord(b)));
const span = dates.length ? `${dates[0].slice(0, 5)} to ${dates.at(-1)}` : 'UNKNOWN';
// The real draw is known once knockout results or a knockouts staged run exist.
const real = results().some((r) => r.phase === 'Knockouts' && r.team_a && r.team_b) || series().some((s) => s.set === 'knockouts');

const ov = overview();
const pts = (ov.pickems_points ?? '').match(/Knockouts ([^=.]+?) = (\d+)/);
const ptsText = pts ? pts[1].replace(/\bQF\b/, 'quarterfinal').replace(/\bSF\b/, 'semifinal') : 'UNKNOWN';
const lock = (ov.locks_nz ?? '').match(/Knockouts (\d\d\/\d\d\/\d{4} \d\d:\d\d)/)?.[1];
const lockText = lock ? `${lock} NZDT` : 'UNKNOWN';

// How far each team goes: ratings.json (design/lore/README.md), the frozen run Home's title odds also use.
const src = ratings().map((r) => ({ code: r.code, name: displayName(r.name), region: r.region, p: [r.p_advance, r.p_semis, r.p_final, r.p_champion] }));
const path = src.sort((a, b) => (b.p[3] ?? -1) - (a.p[3] ?? -1)).slice(0, 10);

const createdNz = (v.rows[0]?.created_nz ?? 'UNKNOWN').replace(/(\d\d:\d\d):\d\d/, '$1');
const setName = v.set === 'baseline' ? 'Frozen baseline' : `Latest staged run (${setLabel(v.set)})`;
const footer = `${setName}, predicted ${createdNz}.${real ? '' : ' The bracket fills in after the Swiss stage and the 31/10 draw.'}`;
// Before the draw no slot has teams: quarterfinals wait for the Swiss stage, later rounds for the round before.
const FEED: Record<string, [string, string]> = { 'KO-SF1': ['QF1', 'QF2'], 'KO-SF2': ['QF3', 'QF4'], 'KO-F': ['SF1', 'SF2'] };
const slot = (s: Series) => {
  const f = FEED[s.id];
  return { name: s.id.replace(/^KO-/, '').replace(/^F$/, 'Final'), sides: f ? [`Winner ${f[0]}`, `Winner ${f[1]}`] : ['Swiss qualifier', 'Swiss qualifier'],
    note: f ? `After ${f[0]} and ${f[1]}.` : 'From the Swiss stage and the 31/10 draw.', when: startNz(s).replace(/^(\d\d\/\d\d)\/\d{4}/, '$1') };
};
---
<Base title="Knockouts" active="knockouts" description="Eight teams, one cup: the knockout bracket and how far each team goes." footer={{ left: footer }}>
  <section class="top">
    <div class="intro">
      <span class="eyebrow">Knockouts, Allen then Brooklyn, {span} NZDT</span>
      <h1>Eight teams, one cup</h1>
      <p class="lede ph-lede">{real ? '' : 'Teams set by the Swiss stage and the 31/10 draw. '}Pick'Ems lock {lock ? `${lock.slice(0, 5)}${lock.slice(10)} NZDT` : 'UNKNOWN'}.</p>
      <p class="lede dt-lede">Every series Bo5 with Fearless Draft. {real ? 'The bracket below follows the real draw.' : 'The eight teams come out of the Swiss stage, and the quarterfinal draw on 31/10 sets who plays whom. Until then the slots are open, and the model gives every team its chances below.'}</p>
    </div>
    <div class="callout">
      <span class="eyebrow">Pick'Ems</span>
      <span class="cl-text">{ptsText}. Locks {lockText}{real ? '.' : ', after the draw.'}</span>
    </div>
  </section>
  <LiveNow phase="Knockouts" />

  <section class="section">
    <div class="section-head"><h2>Bracket</h2><span>{real ? 'Percent is the chance the upper team wins the series. ' : 'Not decided yet. '}Times NZDT.</span></div>
    {v.stageNote && <p class="caption">{v.stageNote}</p>}
    <div class="scroll" tabindex="0" role="region" aria-label="Bracket, scrolls sideways">
      <div class="bracket">
        {cols.map((c, i) => (
          <div class="col">
            <span class:list={['colhead', { gold: i === cols.length - 1 }]}>{c.head}{colDays(c.items) && <span class="cdate">, {colDays(c.items)}</span>}</span>
            <div class="stack">
              {c.items.map((s) => real ? <SeriesCard s={s} large final={i === cols.length - 1} /> : (
                <div class:list={['card', 'tbd', { 'is-final': i === cols.length - 1 }]}>
                  <span class="tbd-meta"><span>{slot(s).name}</span><span>{slot(s).when}</span></span>
                  {slot(s).sides.map((x) => <span class="tbd-side"><span class="tbdm" aria-hidden="true">?</span>{x}</span>)}
                  <span class="caption">{slot(s).note}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>How far each team goes</h2><span>Frozen baseline, over every legal Swiss and knockout draw</span></div>
    <div class="scroll" tabindex="0" role="region" aria-label="How far each team goes, scrolls sideways">
      <div class="path" role="table" aria-label="How far each team goes">
        <div class="pr head" role="row">
          <span role="columnheader"><span class="sr-only">Logo</span></span><span role="columnheader">Team</span><span role="columnheader">Quarterfinal</span><span role="columnheader">Semifinal</span><span role="columnheader">Final</span><span role="columnheader">Champion</span>
        </div>
        {path.map((t) => (
          <div class="pr" role="row">
            <span role="cell"><Logo code={t.code} size={32} /></span>
            <span class="tn" role="cell"><span class="code nm">{t.name}</span><span class="code cd">{t.code}</span><span class="caption"><Icon name={t.region} size={16} label={t.region || 'UNKNOWN'} /></span></span>
            {t.p.map((p, i) => (
              <span class="pc" role="cell">
                <span class:list={['bar', i === 3 ? 'gold' : 'teal']}><i style={`width:${((p ?? 0) * 100).toFixed(1)}%`}></i></span>
                <span class="num">{pct(p, 1)}</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .top { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--space-lg) var(--space-2xl); align-items: end; }
  .intro .lede { max-width: 58ch; }
  .cl-text { font-size: var(--fs-lg); line-height: 1.45; }
  .bracket { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--space-lg); min-width: 760px; }
  .col { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .colhead { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: var(--track-caps); color: var(--muted2); }
  .colhead.gold { color: var(--gold); }
  .colhead .cdate { color: var(--muted); font-family: var(--font-body); font-weight: 600; text-transform: none; letter-spacing: 0; }
  .colhead .ph, .ph-lede { display: none; }
  .stack { display: flex; flex-direction: column; justify-content: space-around; gap: var(--space-sm); min-height: 760px; flex: 1; }
  .path { min-width: 900px; display: flex; flex-direction: column; }
  .pr { display: grid; grid-template-columns: 32px 240px repeat(4, minmax(0, 1fr)); gap: var(--space-md); align-items: center; padding: var(--space-xs) 0; border-top: 1px solid var(--line); }
  .pr.head { border-top: 0; padding: 0 0 var(--space-2xs); font-size: var(--fs-sm); color: var(--muted); }
  .tn { display: flex; flex-direction: column; min-width: 0; }
  .tn .code { font-size: var(--fs-md); line-height: var(--lh-tight); }
  .tn .caption { font-size: var(--fs-xs); }
  .tn .cd { display: none; }
  .pc { display: flex; align-items: center; gap: var(--space-xs); min-width: 0; }
  .pc .bar { flex: 1; }
  .pc .num { width: 56px; text-align: right; }
  @media (max-width: 1000px) { .top { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) {
    .bracket { display: flex; flex-direction: column; gap: var(--space-md); min-width: 0; }
    .colhead { color: var(--gold); }
    .colhead .ph { display: inline; }
    .ph-lede { display: block; }
    .dt-lede, .top .callout { display: none; }
    .stack { min-height: 0; gap: var(--space-2xs); }
    .path { min-width: 560px; }
    .pr { grid-template-columns: 28px 72px repeat(4, minmax(0, 1fr)); gap: var(--space-xs); }
    /* keep logo and team name in view while the bars scroll; the name sits 28px logo + 12px gap in */
    .pr > :nth-child(-n + 2) { position: sticky; z-index: 1; background: var(--bg); align-self: stretch; display: flex; align-items: center; }
    .pr > :nth-child(1) { left: 0; }
    .pr > :nth-child(2) { left: 40px; flex-direction: column; align-items: flex-start; justify-content: center; }
    /* the code, not the full name, so every row keeps one line */
    .tn .nm { display: none; }
    .tn .cd { display: inline; }
    .pc { gap: var(--space-2xs); }
    .pc .num { width: 44px; }
  }
  /* open slot before the draw: no teams, just who it waits for */
  .tbd { cursor: default; gap: var(--space-xs); }
  .tbd:hover { background: var(--surface); border-color: transparent; }
  .tbd.is-final:hover { border-color: var(--gold); }
  .tbd-meta { display: flex; justify-content: space-between; font-size: var(--fs-sm); color: var(--muted); }
  .tbd-side { display: flex; align-items: center; gap: var(--space-xs); font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); text-transform: uppercase; letter-spacing: var(--track-caps); color: var(--muted2); }
  .tbdm { width: 28px; height: 28px; display: inline-grid; place-items: center; border-radius: 50%; border: 1px dashed var(--line-head); color: var(--dim); font-size: var(--fs-sm); flex: none; }
</style>
