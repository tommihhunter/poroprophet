---
/* Playground: "what if" Swiss and knockouts, played in the browser by public/js/playground.js.
   The page embeds the 16 Swiss teams, their pair chances (matchups), the real Swiss and knockout rows (results) and
   the live odds (live(), else the frozen ratings) as JSON; the script does the rest. Nothing here feeds the model. */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { live, matchups, ratings, regionOf, results } from '../lib/data';
import { SWISS_POOLS } from '../lib/swiss';
import { url } from '../lib/url';

type Row = ReturnType<typeof results>[number] & { round?: number };
const rs = results() as Row[];
const lv = live();
const isLive = lv.length > 0;
const odds = isLive ? lv.map((l) => ({ ...l, code: l.team })) : ratings().map((r) => ({ ...r, p_playin_win: r.p_playin }));

// The 16th team: the Play-In winner from the results or the round 1 draw (lib/swiss.ts), else the model's favourite.
const pools = SWISS_POOLS();
const piFav = odds.filter((r) => r.p_playin_win != null).sort((a, b) => Number(b.p_playin_win) - Number(a.p_playin_win))[0]?.code ?? 'UNKNOWN';
const assumedPi = pools[3][3] === 'Play-In winner' ? piFav : null;
if (assumedPi) pools[3][3] = assumedPi;
const teams = pools.flat();

// Round 1 as drawn; before the draw, the first legal draw by the rule (pool 1 v pool 4, pool 2 v pool 3, no same region).
let swissRows = rs.filter((r) => r.phase === 'Swiss' && r.kind === 'series' && r.team_a && r.team_b && r.round)
  .map((r) => ({ round: Number(r.round), a: r.team_a!, b: r.team_b!, bo: Number(r.bo) || 1, w: r.winner ?? null }));
const r1Drawn = swissRows.filter((r) => r.round === 1).length === 8;
if (!r1Drawn) {
  const perms = (xs: string[]): string[][] => (xs.length <= 1 ? [xs] : xs.flatMap((x, i) => perms([...xs.slice(0, i), ...xs.slice(i + 1)]).map((p) => [x, ...p])));
  const half = (top: string[], low: string[]) => perms(low).map((p) => top.map((t, i) => [t, p[i]])).find((ps) => ps.every(([a, b]) => regionOf(a) !== regionOf(b))) ?? [];
  swissRows = [...half(pools[0], pools[3]), ...half(pools[1], pools[2])].map(([a, b]) => ({ round: 1, a, b, bo: 1, w: null }));
}
// stage from the id: hand-made KO-QF1..4 / KO-SF1..2 (HANDOVER.md step 4) or bot KO-QF-<A>-<B>; id order = bracket order
const ko = rs.filter((r) => r.phase === 'Knockouts' && r.team_a && r.team_b).sort((x, y) => x.id.localeCompare(y.id))
  .map((r) => ({ stage: /^KO-(QF|SF|F)/.exec(r.id)?.[1] ?? '', a: r.team_a!, b: r.team_b!, w: r.winner ?? null }));

const set = new Set(teams);
const pairs = Object.fromEntries(matchups().filter((m) => set.has(m.a) && set.has(m.b)).map((m) => [`${m.a}|${m.b}`, [m.p_game, m.p_bo3, m.p_bo5]]));
const base = Object.fromEntries(odds.filter((r) => set.has(r.code)).map((r) => [r.code, [r.p_advance, r.p_semis, r.p_final, r.p_champion].map(Number)]));
const logos = Object.fromEntries(teams.map((t) => [t, existsSync(resolve(process.cwd(), 'public', 'art', 'logos', `${t}.png`)) ? url(`art/logos/${t}.png`) : null]));
const data = { teams, pairs, swiss: swissRows, ko, live: base, logos };

const when = isLive ? lv[0]?.generated_nz : null;
const oddsLabel = isLive ? `the live odds${when ? ` (${when})` : ''}` : 'the frozen baseline';
const assumption = r1Drawn ? null
  : `Round 1 is not drawn yet, so the playground starts from a legal draw by the pool rule${assumedPi ? ` with ${assumedPi} as the assumed Play-In winner` : ''}.`;
---
<Base title="Playground" active="playground" description="What if: pick the Swiss and knockout winners yourself and see how far each team goes.">
  <section class="intro">
    <span class="eyebrow">What if, Swiss and knockouts</span>
    <h1>Call it yourself</h1>
    <p class="lede">Tap a winner in every series and lock in the round: the next one is drawn by record, through the knockouts to a champion. Then see how far each team goes from your picks.</p>
    <p class="caption pg-note">It starts from the real results, which stay locked. The odds here use the model's fixed pair chances, so they can differ slightly from {oddsLabel}, which are recomputed after every result. Nothing you pick changes our predictions.{assumption ? ` ${assumption}` : ''}</p>
  </section>

  <div id="pg" class="pg">
    <noscript><p class="panel">The playground needs JavaScript. The <a class="gold" href={url('swiss/')}>Swiss page</a> has the bracket and our picks without it.</p></noscript>
    <section class="section" aria-labelledby="pg-stage">
      <div class="section-head">
        <h2 id="pg-stage">Round 1</h2>
        <span id="pg-progress" aria-live="polite"></span>
      </div>
      <div class="pg-bar">
        <div class="pg-acts">
          <button type="button" class="pg-btn" data-act="model" title="Fill the open series with the model's favourites">Model picks</button>
          <button type="button" class="pg-btn" data-act="roll" title="Fill the open series by the model's chances">Roll</button>
          <button type="button" class="pg-btn pri" data-act="lock">Lock in</button>
        </div>
        <div class="pg-acts">
          <button type="button" class="pg-btn" data-act="undo">Undo</button>
          <button type="button" class="pg-btn" data-act="reset">Reset</button>
        </div>
      </div>
      <div id="pg-champ" class="pg-champ panel" hidden></div>
      <div id="pg-round" class="pg-round"></div>
    </section>

    <section class="section" aria-labelledby="pg-st-h">
      <div class="section-head">
        <h2 id="pg-st-h">Standings</h2>
        <span>Swiss records with your picks so far</span>
      </div>
      <div id="pg-standings" class="pg-standings panel"></div>
    </section>

    <section class="section pg-odds" aria-labelledby="pg-odds-h">
      <div class="section-head">
        <h2 id="pg-odds-h">Odds from here</h2>
        <span id="pg-odds-cap">Simulates everything you have not picked yet</span>
      </div>
      <div class="pg-acts">
        <button type="button" class="pg-btn pri" data-run="10000">Run 10,000</button>
        <button type="button" class="pg-btn" data-run="1000" title="Quicker, but rougher">Run 1,000</button>
        <span id="pg-odds-status" class="caption" aria-live="polite">Not run yet.</span>
      </div>
      <ul class="pg-leg" aria-hidden="true" hidden><li><i class="s0"></i>Knockouts</li><li><i class="s1"></i>Semis</li><li><i class="s2"></i>Final</li><li><i class="s3"></i>Champion</li><li class="pg-leg-d">Change against {oddsLabel}, champion %; ~0 means within the run's sampling noise</li></ul>
      <ol id="pg-odds" class="pg-odds-rows"></ol>
    </section>
  </div>
  <script type="application/json" id="pg-data" set:html={JSON.stringify(data)} />
  <script is:inline src={url('js/playground.js')} defer></script>
</Base>
<style is:global>
  .pg-note { max-width: 80ch; }
  .pg { display: flex; flex-direction: column; gap: var(--space-xl); min-width: 0; }
  .pg-bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-xs); }
  .pg-acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs); }
  .pg-btn {
    appearance: none; cursor: pointer; min-height: 44px; padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius-pill);
    border: 1px solid var(--split-off); background: transparent; color: var(--fg2); font-weight: 600; font-size: var(--fs-sm);
    transition: color 120ms ease, background-color 120ms ease, border-color 120ms ease;
  }
  .pg-btn:not(:disabled):hover { color: var(--gold); }
  .pg-btn:not(:disabled):active { color: var(--muted2); background: var(--hover); }
  .pg-btn.pri { border-color: var(--gold); color: var(--gold); }
  .pg-btn.pri:not(:disabled):hover { background: var(--gold); color: var(--bg); }
  .pg-btn:disabled { cursor: default; opacity: 0.4; }

  .pg-round { display: flex; flex-direction: column; gap: var(--space-md); }
  .pg-group { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .pg-gh { display: flex; gap: var(--space-xs); align-items: baseline; font-size: var(--fs-sm); color: var(--muted); }
  .pg-gh .code { color: var(--fg2); font-size: var(--fs-md); }
  .pg-ms { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-xs); }
  .pg-m { display: flex; flex-direction: column; gap: 2px; padding: var(--space-3xs); background: var(--surface); border-radius: var(--radius-sm); box-shadow: var(--inset); }
  .pg-t {
    appearance: none; display: flex; align-items: center; gap: var(--space-2xs); width: 100%; min-height: 44px; padding: var(--space-3xs) var(--space-xs);
    border: 0; border-radius: var(--radius-bar); background: transparent; color: var(--fg); text-align: left; cursor: pointer;
    transition: color 120ms ease, background-color 120ms ease;
  }
  .pg-t:hover { background: var(--hover); }
  .pg-t:active { background: var(--line-strong); }
  .pg-t:focus-visible { outline-offset: -2px; }
  .pg-t .code { flex: 1 1 auto; min-width: 0; font-size: var(--fs-lg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pg-t .v { font-weight: 600; font-size: var(--fs-sm); color: var(--muted); }
  .pg-t .v.fav { color: var(--fg); }
  .pg-t[aria-pressed="true"] { background: var(--line-head); }
  .pg-m.picked .pg-t[aria-pressed="false"] { color: var(--muted); }
  .pg-m.picked .pg-t[aria-pressed="false"] .logo, .pg-m.picked .pg-t[aria-pressed="false"] .disc { opacity: 0.5; }
  .pg-t:disabled { cursor: default; }
  .pg-t:disabled:hover { background: transparent; }
  .pg-t[aria-pressed="true"]:disabled:hover { background: var(--line-head); }
  .pg-real { font-size: var(--fs-xs); color: var(--muted); padding: 0 var(--space-xs); }

  .pg-champ { display: flex; align-items: center; gap: var(--space-sm); }
  .pg-champ .code { font-size: var(--fs-2xl); color: var(--gold); }

  .pg-standings { display: flex; flex-direction: column; padding: var(--space-2xs) var(--space-md); }
  .pg-rec { display: grid; grid-template-columns: 128px minmax(0, 1fr); align-items: center; gap: var(--space-sm); padding: var(--space-xs) 0; border-top: 1px solid var(--line); min-width: 0; }
  .pg-rec:first-child { border-top: 0; }
  .pg-rec h3 { font-size: var(--fs-md); color: var(--muted2); white-space: nowrap; }
  .pg-rec h3.teal { color: var(--teal); }
  .pg-rec h3.risk { color: var(--risk); }
  .pg-chips { display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-xs); }
  .pg-chip { display: inline-flex; align-items: center; gap: var(--space-3xs); font-size: var(--fs-sm); }

  /* nested bars, the TitleRace look (components/TitleRace.astro) */
  .pg-odds { --s0: color-mix(in srgb, var(--bar-alt) 42%, var(--track)); --s1: color-mix(in srgb, var(--bar-alt) 68%, var(--track)); --s2: var(--bar-alt); --s3: color-mix(in srgb, var(--bar-alt) 55%, var(--fg)); }
  .pg-odds .s0 { background: var(--s0); } .pg-odds .s1 { background: var(--s1); } .pg-odds .s2 { background: var(--s2); } .pg-odds .s3 { background: var(--s3); }
  .pg-leg { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-sm); font-size: var(--fs-sm); color: var(--muted); }
  .pg-leg li { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .pg-leg i { width: 14px; height: 8px; border-radius: 2px; }
  .pg-leg .pg-leg-d { margin-left: auto; }
  .pg-odds-rows { list-style: none; margin: 0; padding: 0; }
  .pg-odds-rows.stale { opacity: 0.5; }
  .pg-row { display: grid; grid-template-columns: 28px 96px minmax(0, 1fr) 72px 56px; align-items: center; gap: var(--space-sm); padding: var(--space-xs) 0; border-top: 1px solid var(--line); }
  .pg-row .rk { font-size: var(--fs-sm); color: var(--dim); }
  .pg-row .code { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: var(--fs-lg); }
  .pg-row .bar4 { position: relative; display: block; height: 10px; border-radius: var(--radius-bar); background: var(--track); overflow: hidden; min-width: 0; }
  .pg-row .bar4 > i { position: absolute; inset: 0 auto 0 0; border-radius: var(--radius-bar); }
  .pg-row .p { text-align: right; font-size: var(--fs-lg); }
  .pg-row .d { text-align: right; font-size: var(--fs-sm); color: var(--muted); }
  .pg-row .d.up { color: var(--teal); }
  .pg-row .d.down { color: var(--risk); }
  .pg-row.out { color: var(--muted); }

  @media (max-width: 1100px) { .pg-ms { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .pg-ms { gap: var(--space-2xs); }
    .pg-t { padding: var(--space-3xs) var(--space-2xs); gap: var(--space-3xs); }
    .pg-rec { grid-template-columns: 120px minmax(0, 1fr); gap: var(--space-xs); }
    .pg-bar { flex-direction: column; }
    .pg-acts .pg-btn { flex: 1 1 auto; }
    .pg-leg .pg-leg-d { margin-left: 0; flex-basis: 100%; }
    .pg-row { grid-template-columns: 84px minmax(0, 1fr) 56px 44px; gap: var(--space-xs); }
    .pg-row .rk { display: none; }
    .pg-row .bar4 { height: 8px; }
  }
</style>
