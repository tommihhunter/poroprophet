---
/* Playground: "what if" Swiss and knockouts, played in the browser by public/js/playground.js.
   The page embeds the 16 Swiss teams, their pair chances (matchups), the real Swiss and knockout rows (results) and
   the live odds (live(), else the frozen ratings) as JSON; the script does the rest. Nothing here feeds the model. */
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../layouts/Base.astro';
import { live, matchups, ratings, regionOf, results } from '../lib/data';
import { SWISS_POOLS } from '../lib/swiss';
import { url } from '../lib/url';

type Row = ReturnType<typeof results>[number] & { round?: number };
const rs = results() as Row[];
const lv = live();
const isLive = lv.length > 0;
const odds = isLive ? lv.map((l) => ({ ...l, code: l.team })) : ratings().map((r) => ({ ...r, p_playin_win: r.p_playin }));

// The 16th team: the Play-In winner from the results or the round 1 draw (lib/swiss.ts), else the model's favourite.
const pools = SWISS_POOLS();
const piFav = odds.filter((r) => r.p_playin_win != null).sort((a, b) => Number(b.p_playin_win) - Number(a.p_playin_win))[0]?.code ?? 'UNKNOWN';
const assumedPi = pools[3][3] === 'Play-In winner' ? piFav : null;
if (assumedPi) pools[3][3] = assumedPi;
const teams = pools.flat();

// Round 1 as drawn; before the draw, the first legal draw by the rule (pool 1 v pool 4, pool 2 v pool 3, no same region).
let swissRows = rs.filter((r) => r.phase === 'Swiss' && r.kind === 'series' && r.team_a && r.team_b && r.round)
  .map((r) => ({ round: Number(r.round), a: r.team_a!, b: r.team_b!, bo: Number(r.bo) || 1, w: r.winner ?? null, sa: r.score_a ?? null, sb: r.score_b ?? null }));
const r1Drawn = swissRows.filter((r) => r.round === 1).length === 8;
if (!r1Drawn) {
  const perms = (xs: string[]): string[][] => (xs.length <= 1 ? [xs] : xs.flatMap((x, i) => perms([...xs.slice(0, i), ...xs.slice(i + 1)]).map((p) => [x, ...p])));
  const half = (top: string[], low: string[]) => perms(low).map((p) => top.map((t, i) => [t, p[i]])).find((ps) => ps.every(([a, b]) => regionOf(a) !== regionOf(b))) ?? [];
  swissRows = [...half(pools[0], pools[3]), ...half(pools[1], pools[2])].map(([a, b]) => ({ round: 1, a, b, bo: 1, w: null }));
}
// stage from the id: hand-made KO-QF1..4 / KO-SF1..2 (HANDOVER.md step 4) or bot KO-QF-<A>-<B>; id order = bracket order
const ko = rs.filter((r) => r.phase === 'Knockouts' && r.team_a && r.team_b).sort((x, y) => x.id.localeCompare(y.id))
  .map((r) => ({ stage: /^KO-(QF|SF|F)/.exec(r.id)?.[1] ?? '', a: r.team_a!, b: r.team_b!, w: r.winner ?? null, sa: r.score_a ?? null, sb: r.score_b ?? null }));

const set = new Set(teams);
const pairs = Object.fromEntries(matchups().filter((m) => set.has(m.a) && set.has(m.b)).map((m) => [`${m.a}|${m.b}`, [m.p_game, m.p_bo3, m.p_bo5]]));
const base = Object.fromEntries(odds.filter((r) => set.has(r.code)).map((r) => [r.code, [r.p_advance, r.p_semis, r.p_final, r.p_champion].map(Number)]));
const logos = Object.fromEntries(teams.map((t) => [t, existsSync(resolve(process.cwd(), 'public', 'art', 'logos', `${t}.png`)) ? url(`art/logos/${t}.png`) : null]));
const data = { teams, pairs, swiss: swissRows, ko, live: base, logos };

const when = isLive ? lv[0]?.generated_nz : null;
const oddsLabel = isLive ? `the live odds${when ? ` (${when})` : ''}` : 'the frozen baseline';
const assumption = r1Drawn ? null
  : `Round 1 is not drawn yet, so the playground starts from a legal draw by the pool rule${assumedPi ? ` with ${assumedPi} as the assumed Play-In winner` : ''}.`;
---
<Base title="Playground" active="playground" description="What if: pick the Swiss and knockout winners yourself and see how far each team goes.">
  <section class="intro">
    <span class="eyebrow">What if, Swiss and knockouts</span>
    <h1>Call it yourself</h1>
    <p class="lede">Tap a winner in every series and lock in the round: the next one is drawn by record, through the knockouts to a champion. Then see how far each team goes from your picks.</p>
    <p class="caption pg-note">It starts from the real results, which stay locked. The odds here use the model's fixed pair chances, so they can differ slightly from {oddsLabel}, which are recomputed after every result. Nothing you pick changes our predictions.{assumption ? ` ${assumption}` : ''}</p>
  </section>

  <div id="pg" class="pg">
    <noscript><p class="panel">The playground needs JavaScript. The <a class="gold" href={url('swiss/')}>Swiss page</a> has the bracket and our picks without it.</p></noscript>
    <section class="section pg-road" aria-labelledby="pg-road-h">
      <div class="section-head">
        <h2 id="pg-road-h">Your bracket</h2>
        <span>Earlier rounds change only via Undo. Real results show the score.</span>
      </div>
      <div class="pg-bar">
        <p class="pg-now"><span id="pg-stage" class="code">Swiss round 1</span><span id="pg-progress" aria-live="polite"></span></p>
        <div class="pg-acts">
          <button type="button" class="pg-btn" data-act="model" title="Fill the open series with the model's favourites">Model picks</button>
          <button type="button" class="pg-btn" data-act="roll" title="Fill the open series by the model's chances">Roll</button>
          <button type="button" class="pg-btn pri" data-act="lock">Lock in</button>
          <button type="button" class="pg-btn" data-act="undo">Undo</button>
          <button type="button" class="pg-btn" data-act="reset">Reset</button>
          <button type="button" class="pg-btn" data-act="end" title="Roll every open series and lock in every round through the final. One Undo goes back to here.">Roll to the end</button>
        </div>
      </div>
      <div class="scroll pg-sc" tabindex="0" role="region" aria-label="Your bracket, scrolls sideways">
        <div id="pg-road" class="pg-road-in"></div>
      </div>
    </section>

    <section class="section pg-odds" aria-labelledby="pg-odds-h">
      <div class="section-head">
        <h2 id="pg-odds-h">Odds from here</h2>
        <span id="pg-odds-cap">Simulates everything you have not picked yet</span>
      </div>
      <div class="pg-acts">
        <button type="button" class="pg-btn pri" data-run="10000">Run 10,000</button>
        <button type="button" class="pg-btn" data-run="1000" title="Quicker, but rougher">Run 1,000</button>
        <span id="pg-odds-status" class="caption" aria-live="polite">Not run yet.</span>
      </div>
      <ul class="pg-leg" aria-hidden="true" hidden><li><i class="s0"></i>Knockouts</li><li><i class="s1"></i>Semis</li><li><i class="s2"></i>Final</li><li><i class="s3"></i>Champion</li><li class="pg-leg-d">Change against {oddsLabel}, champion %; ~0 means within the run's sampling noise</li></ul>
      <ol id="pg-odds" class="pg-odds-rows"></ol>
    </section>
  </div>
  <script type="application/json" id="pg-data" set:html={JSON.stringify(data)} />
  <script is:inline src={url('js/playground.js')} defer></script>
</Base>
<style is:global>
  .pg-note { max-width: 80ch; }
  .pg { display: flex; flex-direction: column; gap: var(--space-xl); min-width: 0; }
  /* control bar: sticky under the site header on desktop (Header.astro .hdr, 76px plus its border), above the bottom bar on phone */
  .pg-bar {
    position: sticky; top: 77px; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--space-2xs) var(--space-sm); padding: var(--space-2xs) 0; background: var(--bg); border-bottom: 1px solid var(--line);
  }
  .pg-now { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-3xs) var(--space-xs); font-size: var(--fs-sm); color: var(--muted); }
  .pg-now .code { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); color: var(--fg); }
  .pg-acts { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs); }
  .pg-btn {
    appearance: none; cursor: pointer; min-height: 44px; padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius-pill);
    border: 1px solid var(--split-off); background: transparent; color: var(--fg2); font-weight: 600; font-size: var(--fs-sm);
    transition: color 120ms ease, background-color 120ms ease, border-color 120ms ease;
  }
  .pg-btn:not(:disabled):hover { color: var(--gold); }
  .pg-btn:not(:disabled):active { color: var(--muted2); background: var(--hover); }
  .pg-btn.pri { border-color: var(--gold); color: var(--gold); }
  .pg-btn.pri:not(:disabled):hover { background: var(--gold); color: var(--bg); }
  .pg-btn:disabled { cursor: default; opacity: 0.4; }

  /* the road: eight fixed columns, R1 to R5, Through above Out, QF, then SF above Final above Champion. Every slot is
     drawn from the start (blank cards the size of filled ones) and only fills in, so nothing moves as the bracket fills.
     It fits the page from 1280px (8 x 148px plus gaps, drawn at 90%) and scrolls sideways inside .pg-sc below that. */
  .pg-sc { --row: 30px; --card: calc(2 * var(--row) + 2 * var(--space-3xs) + 2px); --gap: var(--space-2xs); position: relative; padding-bottom: var(--space-2xs); }
  .pg-road-in { display: grid; grid-template-columns: repeat(8, minmax(148px, 1fr)); gap: var(--gap); align-items: start; }
  .rd { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; padding: var(--space-2xs); border-radius: var(--radius); }
  .rd > summary { display: none; }
  .stk { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .rd.cur { background: color-mix(in srgb, var(--surface) 55%, var(--bg)); }
  .rd-head { display: flex; flex-direction: column; gap: 2px; padding-bottom: var(--space-2xs); border-bottom: 1px solid var(--line-strong); }
  .rd-head h3 { font-size: var(--fs-md); color: var(--muted2); white-space: nowrap; }
  .rd.cur .rd-head h3 { color: var(--fg); }
  .rd-head p { font-size: var(--fs-xs); color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rd.cur .rd-head p { color: var(--fg2); font-weight: 600; }
  .rd-head h3.teal { color: var(--teal); }
  .rd-head h3.risk { color: var(--risk); }
  .pg-group { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .pg-gh { display: flex; justify-content: space-between; align-items: baseline; font-size: var(--fs-xs); color: var(--muted); }
  .pg-gh .code { color: var(--fg2); font-size: var(--fs-sm); }
  .pg-ms { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .pg-list { display: flex; flex-direction: column; gap: var(--space-3xs); }
  /* cards: one fixed size whether blank or filled; a match card is two team rows, a Through / Out slot one */
  .pg-card { box-sizing: border-box; display: flex; flex-direction: column; height: var(--card); padding: var(--space-3xs); border: 1px solid transparent; border-radius: var(--radius-sm); }
  .pg-m, .pg-slot { background: var(--surface); box-shadow: var(--inset); }
  .pg-slot { height: calc(var(--row) + 2px); padding: 0 var(--space-3xs); }
  .pg-blank { background: transparent; box-shadow: none; border: 1px dashed var(--line-head); }
  .pg-blank .pg-t { font-size: var(--fs-xs); color: var(--muted); white-space: nowrap; overflow: hidden; }
  /* a team row: a button in the current round, a plain row everywhere else, the same height either way */
  .pg-t {
    appearance: none; display: flex; align-items: center; gap: 6px; width: 100%; height: var(--row); flex: none; padding: 0 var(--space-3xs);
    border: 0; border-radius: var(--radius-bar); background: transparent; color: var(--muted); text-align: left; font-size: var(--fs-sm);
  }
  .pg-t .code { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pg-t.win { color: var(--fg); }
  div.pg-t:not(.win) .logo, div.pg-t:not(.win) .disc { opacity: 0.6; }
  button.pg-t { color: var(--fg); cursor: pointer; transition: color 120ms ease, background-color 120ms ease; }
  button.pg-t:hover { background: var(--hover); }
  button.pg-t:active { background: var(--line-strong); }
  button.pg-t:focus-visible { outline-offset: -2px; }
  button.pg-t[aria-pressed="true"] { background: var(--line-head); }
  .pg-m.picked button.pg-t[aria-pressed="false"] { color: var(--muted); }
  .pg-m.picked button.pg-t[aria-pressed="false"] .logo, .pg-m.picked button.pg-t[aria-pressed="false"] .disc { opacity: 0.5; }
  button.pg-t:disabled { cursor: default; }
  button.pg-t:disabled:hover { background: transparent; }
  button.pg-t[aria-pressed="true"]:disabled:hover { background: var(--line-head); }
  .pg-t .v { flex: none; font-weight: 600; font-size: var(--fs-xs); color: var(--muted); }
  .pg-t .v.fav { color: var(--fg); }

  /* knockouts: the QF and SF columns split the same height into equal slots, so each semifinal sits level with the pair
     it comes from; the lines run through the column gap and meet in its middle */
  .ko-slots { display: flex; flex-direction: column; }
  .ko-l .ko-slots, .ko-r .ko-slots { height: calc(4 * (var(--card) + 2 * var(--space-3xs))); }
  .ko-slot { position: relative; flex: 1 1 0; display: flex; flex-direction: column; justify-content: center; padding: var(--space-3xs) 0; }
  .ko-l .ko-slot::after { content: ''; position: absolute; left: 100%; width: calc(var(--space-2xs) + var(--gap) / 2); border: 0 solid var(--line-head); }
  .ko-l .ko-slot:nth-child(odd)::after { top: 50%; bottom: 0; border-top-width: 1px; border-right-width: 1px; }
  .ko-l .ko-slot:nth-child(even)::after { top: 0; bottom: 50%; border-bottom-width: 1px; border-right-width: 1px; }
  .ko-r .ko-slot::before { content: ''; position: absolute; right: 100%; top: 50%; width: calc(var(--space-2xs) + var(--gap) / 2); border-top: 1px solid var(--line-head); }
  .pg-champ { height: 152px; gap: var(--space-2xs); padding: var(--space-xs); background: var(--surface); box-shadow: var(--inset); }
  .pg-champ.pg-blank { justify-content: center; align-items: center; background: transparent; box-shadow: none; }
  .pg-champ .who { display: flex; align-items: center; gap: var(--space-2xs); }
  .pg-champ .code { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-xl); color: var(--fg); }
  .pg-champ .path { font-size: var(--fs-xs); color: var(--fg2); }

  /* nested bars, the TitleRace look (components/TitleRace.astro) */
  .pg-odds { --s0: color-mix(in srgb, var(--bar-alt) 42%, var(--track)); --s1: color-mix(in srgb, var(--bar-alt) 68%, var(--track)); --s2: var(--bar-alt); --s3: color-mix(in srgb, var(--bar-alt) 55%, var(--fg)); }
  .pg-odds .s0 { background: var(--s0); } .pg-odds .s1 { background: var(--s1); } .pg-odds .s2 { background: var(--s2); } .pg-odds .s3 { background: var(--s3); }
  .pg-leg { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3xs) var(--space-sm); font-size: var(--fs-sm); color: var(--muted); }
  .pg-leg li { display: inline-flex; align-items: center; gap: var(--space-2xs); }
  .pg-leg i { width: 14px; height: 8px; border-radius: 2px; }
  .pg-leg .pg-leg-d { margin-left: auto; }
  .pg-odds-rows { list-style: none; margin: 0; padding: 0; }
  .pg-odds-rows.stale { opacity: 0.5; }
  .pg-row { display: grid; grid-template-columns: 28px 96px minmax(0, 1fr) 72px 56px; align-items: center; gap: var(--space-sm); padding: var(--space-xs) 0; border-top: 1px solid var(--line); }
  .pg-row .rk { font-size: var(--fs-sm); color: var(--dim); }
  .pg-row .code { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: var(--fs-lg); }
  .pg-row .bar4 { position: relative; display: block; height: 10px; border-radius: var(--radius-bar); background: var(--track); overflow: hidden; min-width: 0; }
  .pg-row .bar4 > i { position: absolute; inset: 0 auto 0 0; border-radius: var(--radius-bar); }
  .pg-row .p { text-align: right; font-size: var(--fs-lg); }
  .pg-row .d { text-align: right; font-size: var(--fs-sm); color: var(--muted); }
  .pg-row .d.up { color: var(--teal); }
  .pg-row .d.down { color: var(--risk); }
  .pg-row.out { color: var(--muted); }

  @media (max-width: 640px) {
    /* phone: the bar sits last in the section and sticks above the bottom bar (BottomBar.astro, 78px) */
    .pg-bar { order: 9; top: auto; bottom: calc(78px + env(safe-area-inset-bottom)); border-bottom: 0; border-top: 1px solid var(--line-strong); }
    .pg-bar .pg-acts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; gap: var(--space-3xs); }
    .pg-bar .pg-btn { padding: var(--space-3xs) var(--space-2xs); min-height: 40px; }
    /* rounds stacked; every round but the current one folds to one line */
    .pg-sc { --row: 40px; overflow: visible; padding-bottom: 0; }
    .pg-road-in { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-xs); }
    .rd { scroll-margin-top: 88px; }
    .rd > summary {
      display: flex; align-items: center; gap: var(--space-2xs); min-height: 44px; cursor: pointer; list-style: none;
      font-size: var(--fs-sm); color: var(--fg2);
    }
    .rd > summary::-webkit-details-marker { display: none; }
    .rd > summary::after { content: '+'; margin-left: auto; color: var(--muted); font-size: var(--fs-lg); }
    .rd[open] > summary::after { content: '\2212'; }
    .rd > summary b { font-family: var(--font-display); text-transform: uppercase; letter-spacing: var(--track-caps); color: var(--fg); white-space: nowrap; }
    details.rd { padding: 0 var(--space-xs); border: 1px solid var(--line); }
    details.rd[open] { padding-bottom: var(--space-xs); }
    details.rd > .rd-head { display: none; }
    .rd .pg-ms, .rd .pg-list, .ko-slots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xs); }
    .ko-l .ko-slots, .ko-r .ko-slots { height: auto; }
    .ko-slot { padding: 0; }
    .ko-slot::before, .ko-slot::after { display: none; }
    .pg-champ { height: 128px; }
    .pg-leg .pg-leg-d { margin-left: 0; flex-basis: 100%; }
    .pg-row { grid-template-columns: 84px minmax(0, 1fr) 56px 44px; gap: var(--space-xs); }
    .pg-row .rk { display: none; }
    .pg-row .bar4 { height: 8px; }
  }
</style>
