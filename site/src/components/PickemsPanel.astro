---
/* Our Pick'Ems for a stage, read in order: what the picks are and how they score, then one card per pick type
   (Go 3-0, Go 0-3, Advance) whose rows show the team and the chance that pick comes true, next to a bar,
   then how close the call was ("Also close": the best teams we did not pick). Swiss page = full; Home = compact
   (same cards, smaller, plus the preliminary note and a link; the latest result is Home's Today band). Any other stage lists its slots as rows. Renders nothing when
   the stage has no Pick'Ems rows yet. */
import Logo from './Logo.astro';
import { pickems, teamName } from '../lib/data';
import { nextLock } from '../lib/nav';
import { STAGES, drawPassed, view } from '../lib/stage';
import { pct } from '../lib/format';
import { url } from '../lib/url';
interface Props { stage: 'swiss' | 'knockouts'; full?: boolean }
const { stage, full = false } = Astro.props;
const st = STAGES.find((s) => s.id === stage)!;
const rows = pickems().filter((p) => p.stage === st.pickemsStage);
const picked = new Set(rows.map((r) => r.pick));
// the best teams we did not pick in this slot, from the slot's alternatives ("GEN 41%, HLE 29%, ...")
const alsoClose = (alt: string) => alt.split(',').map((x) => x.trim()).filter((x) => x && !picked.has(x.split(' ')[0])).slice(0, 2).join(', ');
const CARDS = [
  { key: 'go30', title: 'Go 3-0', tone: 'teal', what: 'Win all three matches', test: (s: string) => s === '3-0' },
  { key: 'go03', title: 'Go 0-3', tone: 'risk', what: 'Lose all three matches', test: (s: string) => s === '0-3' },
  { key: 'adv', title: 'Advance', tone: 'gold', what: 'Reach three wins with one or two losses', test: (s: string) => /^advance/i.test(s) },
].map((c) => {
  const rs = rows.filter((r) => c.test(r.slot));
  return { ...c, rows: rs, close: rs[0] ? alsoClose(rs[0].alternatives ?? '') : '' };
}).filter((c) => c.rows.length);
const swissLayout = stage === 'swiss' && CARDS.length > 0;
const nl = nextLock();
const lock = nl && nl.stage.toLowerCase() === stage ? nl : null;
const draw = /draw on (\d\d\/\d\d)/.exec(st.note)?.[1];
const drawn = drawPassed().passed;
// Preliminary while the Swiss rows are not from a Swiss (or later) staged run.
const prelim = stage === 'swiss' && view(st, 'latest').swissSet === 'baseline';
const prelimLine = prelim ? (drawn ? 'Preliminary: re-run after the round 1 draw.' : `Preliminary until the round 1 draw${draw ? ` on ${draw} (US time)` : ''}, then re-run.`) : '';
const title = `${st.phase} Pick'Ems`;
const pts = stage === 'swiss' ? 'Each correct advancer scores 10 points, with bonuses for the exact record.' : '';
---
{rows.length > 0 && (
  <section class:list={['pk', full ? 'full' : 'panel flush']} aria-label={`Our ${title}`}>
    <div class:list={[full ? 'section-head' : 'panel-head']}>
      {full ? <h2>Our {title}</h2> : <h3 class="pk-title"><span class="pk-your">Our </span>{title}</h3>}
      <div class="pk-chips">
        {full && prelim && <span class="chip outline">Preliminary{draw ? `, re-run after ${draw}` : ''}</span>}
        {lock && <span class="chip lock">Locks {lock.day}<span class="pk-desk">,</span> {lock.time}<span class="pk-desk"> NZDT</span></span>}
      </div>
    </div>
    {full && swissLayout && (
      <p class="pk-how">Pick two teams to go 3-0, two to go 0-3, and six more to advance. The percentage is the model's chance that pick comes true. {pts}</p>
    )}
    {swissLayout ? (
      <div class="pk-cards">
        {CARDS.map((c) => (
          <article class:list={['pk-card', c.key]}>
            <header class="pk-ch">
              <h3 class:list={['pk-ct', c.tone]}>{c.title}</h3>
              <span class="caption">Pick {c.rows.length}</span>
              {full && <span class="caption pk-what">{c.what}</span>}
            </header>
            <ol class="pk-list">
              {c.rows.map((r) => (
                <li>
                  <Logo code={r.pick} size={full ? 32 : 26} />
                  <span class="pk-nm"><span class="code">{r.pick}</span>{full && <span class="caption pk-full">{teamName(r.pick)}</span>}</span>
                  <span class:list={['bar', c.tone === 'gold' ? 'alt' : c.tone]}><i style={`width:${((r.p_correct ?? 0) * 100).toFixed(1)}%`}></i></span>
                  <span class="pk-p">{pct(r.p_correct)}</span>
                </li>
              ))}
            </ol>
            {full && c.close && <p class="caption pk-close">Also close: {c.close}</p>}
          </article>
        ))}
      </div>
    ) : (
      <div class="panel-sec">
        <div class="rows">
          {rows.map((r) => <div class="pk-row"><span class="muted">{r.slot}</span><Logo code={r.pick} size={26} /><span class="code">{r.pick}</span><span class="pk-rp">{pct(r.p_correct)}</span></div>)}
        </div>
      </div>
    )}
    {full && prelimLine && <p class="caption">{prelimLine}</p>}
    {!full && prelimLine && <div class="panel-sec pk-status caption"><span>{prelimLine}</span></div>}
    {!full && <a class="link-row" href={url(`${stage}/`)}>All {st.phase} picks<span class="pk-arrow" aria-hidden="true">→</span></a>}
  </section>
)}
<style>
  .pk.full { display: flex; flex-direction: column; gap: var(--space-sm); }
  .pk-chips { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .pk-how { font-size: var(--fs-lg); color: var(--fg2); max-width: 70ch; line-height: 1.45; }

  /* cards: Go 3-0 and Go 0-3 stacked on the left, Advance (six picks) on the right */
  .pk-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-areas: 'go30 adv' 'go03 adv'; gap: var(--space-md); }
  .go30 { grid-area: go30; } .go03 { grid-area: go03; } .adv { grid-area: adv; }
  .pk-card { display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-md) var(--space-lg); background: var(--surface); border-radius: var(--radius); box-shadow: var(--inset); min-width: 0; }
  .pk-ch { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 0 var(--space-sm); }
  .pk-ct { font-size: var(--fs-xl); }
  .pk-what { grid-column: 1 / -1; }
  .pk-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  /* logo | name | bar | % : the number sits right after the bar, never across the card */
  .pk-list li { display: grid; grid-template-columns: auto minmax(7rem, 11rem) minmax(0, 1fr) 3.5ch; align-items: center; gap: var(--space-sm); padding: var(--space-xs) 0; border-top: 1px solid var(--line); }
  .pk-nm { display: flex; flex-direction: column; min-width: 0; line-height: 1.2; }
  .pk-nm .code { font-size: var(--fs-lg); }
  .pk-full { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pk-p { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); text-align: right; }
  .pk-close { margin-top: auto; }

  /* compact (Home): no "how", no names; the Advance card lists its six picks in two columns */
  .pk:not(.full) .pk-cards { padding: var(--space-md) var(--space-lg); gap: var(--space-sm); grid-template-areas: 'go30 go03' 'adv adv'; }
  .pk:not(.full) .pk-card { padding: 0; background: none; box-shadow: none; gap: var(--space-2xs); }
  .pk:not(.full) .pk-ct { font-size: var(--fs-md); }
  .pk:not(.full) .pk-list li { grid-template-columns: auto 3.5rem minmax(0, 1fr) 3.5ch; gap: var(--space-xs); padding: var(--space-2xs) 0; }
  .pk:not(.full) .pk-nm .code, .pk:not(.full) .pk-p { font-size: var(--fs-md); }
  .pk:not(.full) .adv .pk-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-lg); }
  .pk-status { gap: var(--space-3xs); }
  .pk-arrow { font-size: var(--fs-lg); line-height: 1; }
  .pk-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto 56px; align-items: center; gap: var(--space-xs); }
  .pk-rp { text-align: right; }

  @media (max-width: 900px) {
    .pk-cards, .pk:not(.full) .pk-cards { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'go30' 'go03' 'adv'; }
  }
  @media (max-width: 640px) {
    .pk-your, .pk-desk, .pk-full { display: none; }
    .pk-how { font-size: var(--fs-md); }
    .pk-card { padding: var(--space-sm); }
    .pk-list li { grid-template-columns: auto 3.5rem minmax(0, 1fr) 3.5ch; gap: var(--space-xs); }
    .pk:not(.full) .pk-cards { padding: var(--space-sm); }
    .pk:not(.full) .adv .pk-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
