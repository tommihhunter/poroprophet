---
/* Site header (every page, Home included, so the nav never moves), per design/lore/Site Header.dc.html.
   Desktop: avatar + wordmark, nav, next-lock chip. Under 640px: avatar + page title, compact lock chip. */
import { NAV, nextLock } from '../lib/nav';
import { overview } from '../lib/data';
import { url } from '../lib/url';
interface Props { active: string; title: string }
const { active, title } = Astro.props;
const lock = nextLock();
const raw = overview().next_lock;
// phone: the lock chip only on its own stage's page (Phone Pages.dc.html shows it on Swiss only)
const own = !!lock && active === lock.stage.toLowerCase();
---
<header class="hdr">
  <div class="hdr-in">
    <a class="brand" href={url('')} aria-label="Poro Prophet, Home">
      <img class="avatar" src={url('art/poro/main-256.png')} width="44" height="44" alt="" />
      <span class="word">Poro Prophet</span>
      <span class="ptitle" aria-hidden="true">{active === 'home' ? 'Poro Prophet' : title}</span>
    </a>
    <nav class="hnav" aria-label="Sections">
      {NAV.map((n) => <a href={url(n.path)} aria-current={active === n.id ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    {lock
      ? <span class:list={['chip lock hlock', { 'ph-off': !own }]}><span class="full">{lock.stage} lock {lock.day}, {lock.time} NZDT</span><span class="short">Locks {lock.day}</span></span>
      : raw && <span class="chip lock hlock">{raw}</span>}
  </div>
</header>
<style>
  .hdr { border-bottom: 1px solid var(--line-head); background: var(--bg); position: sticky; top: 0; z-index: 20; }
  /* same content edge as the page and footer (--wrap) */
  .hdr-in { max-width: var(--wrap); margin: 0 auto; padding: var(--space-xs) var(--gutter); min-height: 76px; display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); }
  .brand { display: flex; align-items: center; gap: var(--space-xs); color: var(--fg); }
  .avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px var(--gold); }
  .word, .ptitle, .hnav { text-transform: uppercase; }
  .word, .ptitle { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-xl); letter-spacing: var(--track-caps); line-height: 1.1; }
  .ptitle { display: none; }
  .hnav { display: flex; flex-wrap: wrap; gap: var(--space-3xs); margin-left: auto; font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); letter-spacing: 0.08em; }
  .hnav a { padding: var(--space-2xs) var(--space-xs); border-radius: var(--radius-nav); color: var(--fg2); white-space: nowrap; }
  .hnav a:hover { color: var(--gold); }
  .hnav a:active { color: var(--muted2); }
  .hnav a[aria-current="page"] { background: var(--gold); color: var(--bg); }
  .hlock .short { display: none; }
  /* keep brand, nav and chip on one row (measured with Playground in the nav, 19/10/2026): a tighter nav up to 1640,
     the short chip up to 1520, no chip up to 1400; it fits on one row down to about 1270, the nav wraps below that */
  @media (max-width: 1640px) and (min-width: 641px) {
    .hnav { gap: 0; }
    .hnav a { padding: var(--space-2xs); }
  }
  @media (max-width: 1520px) and (min-width: 641px) {
    .hlock .full { display: none; }
    .hlock .short { display: inline; }
  }
  @media (max-width: 1400px) and (min-width: 641px) { .hlock { display: none; } }
  @media (max-width: 640px) {
    .hdr { border-bottom-color: var(--line-strong); }
    .hdr-in { min-height: 0; padding: var(--space-xs) var(--gutter); flex-wrap: nowrap; gap: var(--space-xs); }
    .brand { min-width: 0; }
    .avatar { width: 36px; height: 36px; }
    .word, .hnav { display: none; }
    .ptitle { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .hlock { margin-left: auto; font-size: var(--fs-xs); padding: 0 var(--space-2xs); line-height: 1.6; flex: none; }
    .hlock.ph-off { display: none; }
    .hlock .full { display: none; }
    .hlock .short { display: inline; }
  }
</style>
