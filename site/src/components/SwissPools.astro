---
/* Swiss seed pools (lib/swiss.ts SWISS_POOLS): four compact columns and the round 1 pairing rule.
   Each team links to its team page. */
import Logo from './Logo.astro';
import { SWISS_POOLS } from '../lib/swiss';
import { teamSlug } from '../lib/data';
import { url } from '../lib/url';
const pools = SWISS_POOLS();
---
<section class="section sp" aria-label="Swiss seed pools">
  <div class="section-head">
    <h2>Seed pools</h2>
    <span>Round 1 pairs pool 1 with pool 4 and pool 2 with pool 3, never two teams from the same region.</span>
  </div>
  <div class="sp-grid panel">
    {pools.map((pool, i) => (
      <div class="sp-pool">
        <h3 class="sp-head">Pool {i + 1}</h3>
        <ul>
          {pool.map((t) => (
            <li>{t === 'Play-In winner'
              ? <span class="sp-team muted">Play-In winner</span>
              : <a class="sp-team" href={url(`teams/${teamSlug(t)}/`)}><Logo code={t} size={22} /><span class="code">{t}</span></a>}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
<style>
  .sp-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-md); padding: var(--space-sm) var(--space-md); }
  .sp-pool { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; }
  .sp-head { font-size: var(--fs-sm); color: var(--muted2); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-3xs); }
  .sp-team { display: flex; align-items: center; gap: var(--space-2xs); padding: var(--space-3xs) var(--space-2xs); border-radius: var(--radius-bar); min-width: 0; }
  .sp-team .code { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  a.sp-team { color: var(--fg); }
  a.sp-team:hover .code { color: var(--gold); }
  @media (max-width: 640px) { .sp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm); } }
</style>
