---
/* One series in a bracket, per design/lore/Play-In.dc.html and Knockouts.dc.html.
   Favourite on top with its win chance (or the final score once played), a split bar and a note.
   detail = id of a SeriesDetail to show: renders a selectable <button> (public/js/select.js), otherwise a static card.
   round = phone meta label (the bracket column); label = round name shown before the time on desktop too. */
import Logo from './Logo.astro';
import Tier from './Tier.astro';
import { pct } from '../lib/format';
import { resultFor, startNz } from '../lib/stage';
import type { Series } from '../lib/data';
interface Props { s: Series; detail?: string; selected?: boolean; final?: boolean; round?: string; label?: string; large?: boolean }
const { s, detail, selected = false, final = false, round, label, large = false } = Astro.props;
// half-settled slot (lib/stage.ts settlePlayIn): team_b is 'TBD', shown as s.tbd ("MVK or FURIA"), known team first
const tbd = s.team_b === 'TBD';
const pick = tbd ? s.team_a : s.winner || s.team_a;
const nm = (c: string) => (c === 'TBD' ? s.tbd ?? 'TBD' : c);
const r = resultFor(s);
// once played the winner reads first (desktop top row, phone line), so "FURIA v C9 3-1" never reads as a C9 win
const fav = r ? r.winner : pick;
const dog = fav === s.team_a ? s.team_b : s.team_a;
const goals = (code: string) => (!r ? null : r.team_a === code ? r.score_a : r.score_b);
const [gf, gd] = [goals(fav), goals(dog)];
const pp = tbd ? (s.p_series_a == null ? null : Math.round(s.p_series_a * 100)) : s.p_winner == null ? null : Math.round(s.p_winner * 100);
const pa = pp == null || fav === pick ? pp : 100 - pp; // pre-match split from the top row's side
const when = startNz(s).match(/^(\d\d\/\d\d)\/\d{4} (\d\d:\d\d)/);
const time = when ? `${when[1]} ${when[2]}` : 'UNKNOWN';
// later Play-In rounds: the model's pairing (favourites win earlier rounds) until the bracket settles it
const assumed = !r && /predicted pairing/i.test(s.stage);
const hit = !!r && r.winner === pick;
const tag = hit ? 'Called it' : `Picked ${pick}, wrong`;
const hi = r ? Math.max(Number(r.score_a), Number(r.score_b)) : 0;
const lo = r ? Math.min(Number(r.score_a), Number(r.score_b)) : 0;
const note = tbd ? s.tbd_note ?? '' : !r
  ? `Likeliest ${fav} ${s.score || 'UNKNOWN'} (${pct(s.p_score)})`
  : hit ? `Called it. Score call ${s.score} ${`${hi}-${lo}` === s.score ? 'hit' : 'missed'}` : `Picked ${pick}, wrong.`;
const lead = r ? 0 : tbd && (s.p_series_a ?? 1) < 0.5 ? 1 : 0;
const rows = [
  { code: fav, right: r ? String(gf ?? 'UNKNOWN') : tbd ? pct(s.p_series_a) : pct(s.p_winner) },
  { code: dog, right: r ? String(gd ?? 'UNKNOWN') : tbd ? (s.p_series_a == null ? 'UNKNOWN' : pct(1 - s.p_series_a)) : s.p_winner == null ? 'UNKNOWN' : pct(1 - s.p_winner) },
];
const Tag = detail ? 'button' : 'div';
const attrs = detail ? { type: 'button', 'data-show': detail, 'aria-controls': detail, 'aria-pressed': String(selected) } : {};
---
<Tag class:list={['card', 'sc', { 'is-selected': selected, 'is-final': final, lg: large }]} {...attrs}>
  {round && (
    <span class="meta ph">
      <span>{label ?? round}, {time}</span>
      {r ? <span class:list={['tag', hit ? 'teal' : 'risk']}>{tag}</span> : !tbd && <Tier tier={s.tier} />}
    </span>
  )}
  <span class="meta dt"><span>{label ? `${label}, ` : ''}<span class="nw">{time}</span></span>{!tbd && <Tier tier={s.tier} />}</span>
  <span class="teams dt">
    {rows.map((x, i) => (
      <>
        {x.code === 'TBD' ? <span class="tbdm" aria-hidden="true">?</span> : <Logo code={x.code} size={large ? 32 : 28} />}
        <span class:list={['code', 'name', { lead: i === lead }]}>{nm(x.code)}</span>
        <span class:list={['big', 'val', { lead: i === lead }]}>{x.right}</span>
      </>
    ))}
  </span>
  <span class="split dt" style={`--pa:${pa ?? 50}`} aria-hidden="true"><i></i><i></i></span>
  <span class:list={['notes', { dt: !assumed }]}>
    <span class:list={['note', 'dt', r ? (hit ? 'teal' : 'risk') : 'fg2']}>{note}</span>
    {assumed && <span class="assumed">Assumed pairing: favourites win the earlier rounds</span>}
  </span>
  <span class="line ph">
    <Logo code={fav} size={24} />
    <span class="code">{fav}</span>
    <span class="vs">v {nm(dog)}</span>
    {r ? <span class="big pv">{hi}-{lo}</span> : (
      <span class="big pv">{rows.map((x, i) => <>{i > 0 && <span class="sep"> · </span>}<span class:list={['pn', { lead: i === lead }]}>{x.right}</span></>)}</span>
    )}
  </span>
</Tag>
<style>
  /* card: padding and gap from .card; the favourite (or the winner once played) reads --fg, the other side --muted */
  div.sc { cursor: default; }
  div.sc:hover, div.sc:active { background: var(--surface); }
  div.sc:not(.is-final):hover { border-color: transparent; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2xs); font-size: var(--fs-sm); color: var(--muted); }
  .nw { white-space: nowrap; }
  /* four bracket columns on a laptop: a little less side padding keeps the meta line on one row */
  .sc:not(.lg) { padding: var(--space-sm); }
  .teams { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; align-items: center; gap: var(--space-2xs) var(--space-xs); }
  .lg .teams { grid-template-columns: 32px minmax(0, 1fr) auto; }
  .name { font-size: var(--fs-lg); line-height: var(--lh-tight); min-width: 0; overflow-wrap: anywhere; color: var(--muted); }
  .val { font-size: var(--fs-xl); text-align: right; color: var(--muted); }
  .name.lead, .val.lead { color: var(--fg); }
  .notes { display: flex; flex-direction: column; gap: var(--space-3xs); text-wrap: balance; }
  .note { font-size: var(--fs-sm); }
  .assumed { font-size: var(--fs-xs); color: var(--muted); }
  .tbdm { width: 28px; height: 28px; display: inline-grid; place-items: center; border-radius: 50%; border: 1px dashed var(--line-head); color: var(--dim); font-weight: 700; }
  .ph { display: none; }
  .tag { font-size: var(--fs-xs); font-weight: 600; }
  @media (max-width: 640px) {
    .dt { display: none; }
    .ph { display: flex; }
    .sc { gap: var(--space-2xs); padding: var(--space-xs) var(--space-sm); }
    .notes { order: 9; }
    .line { align-items: center; gap: var(--space-2xs); min-width: 0; }
    .line .code { font-size: var(--fs-lg); }
    .vs { font-size: var(--fs-sm); color: var(--muted); min-width: 0; overflow-wrap: anywhere; }
    .pv { margin-left: auto; font-size: var(--fs-xl); white-space: nowrap; }
    /* before a result: both chances, the favourite's --fg, the other --muted */
    .pn { color: var(--muted); }
    .pn.lead { color: var(--fg); }
    .sep { color: var(--dim); }
    /* knockouts: no round meta, a compact one-line card */
    .sc:not(:has(.meta.ph)) { border-radius: var(--radius-sm); }
    .sc:not(:has(.meta.ph)) .code { font-size: var(--fs-md); }
    .sc:not(:has(.meta.ph)) .pv { font-size: var(--fs-lg); }
  }
</style>
