---
/* Phone bottom bar (< 640px), per design/lore/Phone Pages.dc.html: Home, Play-In, Swiss, Teams, More (the rest of NAV, Playground included).
   A stroke icon (lib/icons.ts) over a --fs-xs label, gold when active. More is a <details> bottom sheet. */
import { NAV } from '../lib/nav';
import { url } from '../lib/url';
import { icon } from '../lib/icons';
const { active } = Astro.props as { active: string };
const pick = (id: string) => NAV.find((n) => n.id === id)!;
const tabs = ['home', 'play-in', 'swiss', 'teams'].map(pick);
const more = ['players', 'knockouts', 'playground', 'scorecard', 'meta', 'demacia-cup'].map(pick);
const moreOn = more.some((n) => n.id === active);
---
<nav class="bbar" aria-label="Sections">
  {tabs.map((n) => <a class="tab" href={url(n.path)} aria-current={active === n.id ? 'page' : undefined}><span class="ic" set:html={icon(n.id)} />{n.label}</a>)}
  <details class="more">
    <summary class:list={['tab', { on: moreOn }]}><span class="ic" set:html={icon('more')} />More</summary>
    <div class="scrim" aria-hidden="true"></div>
    <div class="sheet">
      <span class="grab" aria-hidden="true"></span>
      {more.map((n) => <a href={url(n.path)} aria-current={active === n.id ? 'page' : undefined}><span class="ic" set:html={icon(n.id)} /><span class="tx"><span class="t">{n.label}</span><span class="s">{n.desc}</span></span></a>)}
    </div>
  </details>
</nav>
<script is:inline>
  // close the More sheet on a tap outside it or on Escape
  document.addEventListener('click', (e) => { const d = document.querySelector('.bbar details[open]'); if (d && !e.target.closest('.sheet, .bbar summary')) d.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') document.querySelectorAll('.bbar details[open]').forEach((d) => { d.open = false; d.querySelector('summary').focus(); }); });
</script>
<style>
  .bbar { display: none; }
  @media (max-width: 640px) {
    .bbar {
      display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      padding: var(--space-2xs) var(--space-3xs) max(var(--space-xs), env(safe-area-inset-bottom)); font-size: var(--fs-xs); font-weight: 600; text-align: center;
    }
    /* layers: scrim 0, sheet 1, bar background 2, tabs 3 */
    .bbar::before { content: ''; position: absolute; inset: 0; z-index: 2; background: var(--bg); border-top: 1px solid var(--line-strong); }
    .tab {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-2xs); min-height: 44px;
      color: var(--fg2); white-space: nowrap; cursor: pointer; list-style: none; position: relative; z-index: 3;
      border-radius: var(--radius-sm); transition: color 120ms ease, background-color 120ms ease;
    }
    .tab::-webkit-details-marker { display: none; }
    .tab:hover { color: var(--gold); }
    .tab:active { background: var(--hover); }
    .tab:focus-visible { outline-offset: -2px; }
    .ic, .ic :global(svg) { display: block; width: 22px; height: 22px; flex: none; }
    .tab[aria-current="page"], .tab.on, .more[open] > .tab { color: var(--gold); }
    .scrim { position: fixed; inset: 0; background: var(--scrim); z-index: 0; }
    /* bottom padding clears the bar (78px) plus a step */
    .sheet {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 1;
      display: flex; flex-direction: column; gap: var(--space-3xs); text-align: left;
      background: var(--surface); border-radius: 22px 22px 0 0;
      padding: var(--space-xs) var(--gutter) calc(78px + var(--space-2xs) + env(safe-area-inset-bottom));
      max-height: 100dvh; overflow-y: auto; overscroll-behavior: contain;
    }
    .grab { align-self: center; width: 40px; height: 4px; border-radius: 2px; background: var(--split-off); margin-bottom: var(--space-xs); }
    .sheet a { display: flex; align-items: center; gap: var(--space-sm); padding: var(--space-xs); border-radius: var(--radius-sm); min-height: 44px; }
    .sheet a:hover, .sheet a[aria-current="page"] { background: var(--hover); }
    .sheet a:active { background: var(--line-strong); }
    .sheet a:focus-visible { outline-offset: -2px; }
    .sheet .t { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-lg); line-height: var(--lh-tight); text-transform: uppercase; letter-spacing: var(--track-caps); }
    .sheet a[aria-current="page"] .t { color: var(--gold); }
    .sheet .s { font-size: var(--fs-sm); font-weight: 500; color: var(--muted); }
    .sheet .tx { display: flex; flex-direction: column; gap: 2px; }
    .sheet .ic { color: var(--gold); }
    .more { display: block; }
  }
</style>
