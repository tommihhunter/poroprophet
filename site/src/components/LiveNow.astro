---
/* "Live now / Up next": the next open series (settled pairings, both teams' chances, our pick in gold) and the latest result.
   The site only rebuilds when a result lands, so the state is worked out in the browser from each start time:
   before the start "Starts in 2h 10m", from the start "Live", from 5 hours after it "Result pending" (a Bo5 rarely
   runs past 4 hours). Riot's state at the last publish (data/dash/schedule.json, lib/live.ts) overrides the clock and
   its start time replaces ours: an unstarted series counts down to Riot's start and then reads "Starting", never Live
   or Result pending; an inProgress series shows "Live now" with the game score, a completed one leaves the cards and becomes the latest result
   ("KC won 3-0 against MVK, official stats to follow") until our results row lands. Built-in results always win: a
   played series never shows here. Renders nothing when no series has a start time. Optional `phase` limits it to one stage. */
import Logo from './Logo.astro';
import { results } from '../lib/data';
import { resultFor } from '../lib/grading';
import { STAGES, startNz, view } from '../lib/stage';
import { pct } from '../lib/format';
import { url } from '../lib/url';
import { matchState, nzMs } from '../lib/live';
interface Props { phase?: 'Play-In' | 'Swiss' | 'Knockouts' }
const { phase } = Astro.props;
const iso = (nz: string) => { const t = nzMs(nz); return t == null ? null : new Date(t).toISOString(); };
const open = STAGES.filter((st) => !phase || st.phase === phase)
  .flatMap((st) => view(st, 'latest').rows.map((s) => ({ s, st })))
  .filter(({ s }) => !s.actual && s.team_a && s.team_b && !resultFor(s))
  .map((x) => { const rs = matchState(x.s); return { ...x, rs, when: rs?.start_nz ?? startNz(x.s), at: rs ? new Date(rs.start_utc).toISOString() : iso(startNz(x.s)) }; })
  .filter((x) => x.at)
  .sort((a, b) => a.at!.localeCompare(b.at!));
// only rows whose teams are known: Play-In rows settled by results or round 1; knockout ties only from a real
// knockouts run (the baseline bracket is an assumed draw); never a row marked as an assumed pairing
const settled = open.filter(({ s, st }) => (st.phase !== 'Knockouts' || s.set === 'knockouts') && s.team_b !== 'TBD' && (s.settled || !/predicted pairing|assumed/i.test(s.stage)));
// Riot says finished (and the game wins name a winner): not live any more, shown as the latest result instead
const done = (x: (typeof settled)[number]) => x.rs?.state === 'completed' && x.rs.wins_a !== x.rs.wins_b;
const known = settled.filter((x) => !done(x)).slice(0, 3);
const riotLast = settled.filter(done).at(-1);
const lastRes = results().filter((r) => r.winner && (!phase || r.phase === phase)).at(-1);
const riotLine = riotLast && (() => {
  const { s, rs } = riotLast; const aWon = rs!.wins_a > rs!.wins_b;
  return `${aWon ? s.team_a : s.team_b} won ${Math.max(rs!.wins_a, rs!.wins_b)}-${Math.min(rs!.wins_a, rs!.wins_b)} against ${aWon ? s.team_b : s.team_a}`;
})();
const lastLine = riotLine || (lastRes ? `${lastRes.winner} beat ${lastRes.winner === lastRes.team_a ? lastRes.team_b : lastRes.team_a} ${Math.max(Number(lastRes.score_a), Number(lastRes.score_b))}-${Math.min(Number(lastRes.score_a), Number(lastRes.score_b))}` : '');
const hub = (st: { id: string }) => url(`${st.id}/`);
const short = (nz: string) => nz.replace(/^(\d\d\/\d\d)\/\d{4}/, '$1').replace(/\s*NZDT$/, '');
---
{(known.length > 0 || riotLine) && (
  <section class="live" aria-label="Live now and up next" data-live data-n={Math.min(known.length, 3)}>
    {known.map(({ s, st, when, at, rs }, i) => {
      const live = rs?.state === 'inProgress', ended = rs?.state === 'completed';
      return (
      <a class:list={['lv', { lead: i === 0 }]} href={hub(st)} data-start={live || ended ? undefined : at} data-riot={rs?.state} data-phase={live ? 'live' : ended ? 'pending' : undefined}>
        <span class="lv-state"><i class="dot" aria-hidden="true"></i><span data-state>{live ? 'Live now' : ended ? 'Result pending' : 'Up next'}</span></span>
        <span class="lv-teams">
          <Logo code={s.team_a} size={i === 0 ? 40 : 24} /><span class="code">{s.team_a}</span>
          {live ? <span class="lv-score">{rs!.wins_a}-{rs!.wins_b}</span> : <span class="muted">v</span>}
          <span class="code">{s.team_b}</span><Logo code={s.team_b} size={i === 0 ? 40 : 24} />
        </span>
        <span class="lv-meta">
          <span class="caption">{s.stage.replace(/^Play-In /, '')}, {short(when)} NZDT</span>
          {s.winner && s.p_winner != null && (
            <span class="lv-pick">
              {[s.team_a, s.team_b].map((c, j) => <>{j > 0 && <span class="muted"> · </span>}<span class:list={{ muted: c !== s.winner }}><span class="code">{c}</span> <span class:list={{ gold: c === s.winner }}>{pct(c === s.winner ? s.p_winner : 1 - s.p_winner!)}</span>{c === s.winner && <span class="lv-tag"> our pick</span>}</span></>)}
            </span>
          )}
        </span>
      </a>
      );
    })}
    {lastLine && <p class="caption lv-last">Latest result: {lastLine}{riotLine && <span class="muted">, official stats to follow</span>}.</p>}
  </section>
)}
<script is:inline>
  // Live state from the clock for cards Riot had not started at the last publish. Runs now and every 30 s; no network.
  // A card Riot lists as unstarted never turns Live or Result pending from the clock: past its start it reads "Starting".
  (() => {
    const fmt = (ms) => { const m = Math.round(ms / 60000); return m >= 60 ? `${Math.floor(m / 60)}h ${m % 60}m` : `${m}m`; };
    const tick = () => document.querySelectorAll('[data-live] [data-start]').forEach((el) => {
      const d = Date.parse(el.dataset.start) - Date.now();
      const st = el.querySelector('[data-state]');
      const state = d > 0 ? 'soon' : el.dataset.riot === 'unstarted' ? 'starting' : d > -5 * 3600e3 ? 'live' : 'pending';
      el.dataset.phase = state;
      st.textContent = state === 'soon' ? (d < 36 * 3600e3 ? `Starts in ${fmt(d)}` : 'Up next') : state === 'starting' ? 'Starting' : state === 'live' ? 'Live now' : 'Result pending';
    });
    tick(); setInterval(tick, 30000);
  })();
</script>
<style>
  .live { display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); gap: var(--space-sm); align-items: stretch; }
  .lv { display: flex; flex-direction: column; justify-content: center; gap: var(--space-2xs); padding: var(--space-sm) var(--space-md); background: var(--surface); border-radius: var(--radius); box-shadow: var(--inset); border: 1px solid transparent; transition: border-color 120ms ease, background-color 120ms ease; }
  .lv:hover { color: inherit; background: var(--hover); border-color: var(--line-head); }
  .lv.lead { padding: var(--space-md) var(--space-lg); }
  .lv[data-phase="live"] { border-color: var(--live); box-shadow: 0 0 0 1px var(--live), var(--inset); }
  .lv-state { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dim); }
  .lv[data-phase="live"] .lv-state { color: var(--live); }
  .lv[data-phase="live"] .dot { background: var(--live); box-shadow: 0 0 8px var(--live); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.3; } }
  .lv-teams { display: flex; align-items: center; gap: var(--space-xs); font-size: var(--fs-lg); }
  .lead .lv-teams { font-size: var(--fs-2xl); gap: var(--space-sm); }
  .lv-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3xs) var(--space-md); align-items: baseline; }
  .lv-pick { font-size: var(--fs-sm); color: var(--fg2); }
  .lv-tag { font-size: var(--fs-xs); letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg2); }
  .lv-score { font-family: var(--font-display); font-variant-numeric: tabular-nums; color: var(--live); }
  .lv-last { grid-column: 1 / -1; }
  /* fewer cards fill the row: one card takes the full width, two split 2:1 (no empty half-width gap) */
  .live[data-n="0"], .live[data-n="1"] { grid-template-columns: minmax(0, 1fr); }
  .live[data-n="2"] { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  @media (max-width: 900px) { .live { grid-template-columns: minmax(0, 1fr); } }
</style>
